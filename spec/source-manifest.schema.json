{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/source-manifest.schema.json",
  "title": "Source Manifest",
  "description": "Caller-provided bounded source manifest for OPE setup intake before forecasting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceManifestId",
    "createdAt",
    "domainSetupId",
    "domain",
    "forecastParameters",
    "sources"
  ],
  "properties": {
    "sourceManifestId": { "$ref": "common.schema.json#/$defs/id" },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "domainSetupId": { "$ref": "common.schema.json#/$defs/id" },
    "domain": { "$ref": "common.schema.json#/$defs/domain" },
    "forecastParameters": { "$ref": "#/$defs/forecastParameters" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/sourceEntry" }
    }
  },
  "$defs": {
    "nullableString": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 260
        },
        { "type": "null" }
      ]
    },
    "nullableTimestamp": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/timestamp" },
        { "type": "null" }
      ]
    },
    "nullableDate": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        { "type": "null" }
      ]
    },
    "nullableInteger": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        { "type": "null" }
      ]
    },
    "forecastParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionTemplateId", "horizonLabel", "forecastCloseTime"],
      "properties": {
        "questionTemplateId": { "$ref": "common.schema.json#/$defs/id" },
        "horizonLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "forecastCloseTime": { "$ref": "common.schema.json#/$defs/timestamp" },
        "geography": { "$ref": "#/$defs/nullableString" },
        "serviceDate": { "$ref": "#/$defs/nullableDate" },
        "assetIdentifier": { "$ref": "#/$defs/nullableString" },
        "location": { "$ref": "#/$defs/nullableString" },
        "targetWindow": { "$ref": "#/$defs/nullableString" }
      }
    },
    "sourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceRole",
        "displayName",
        "connectorType",
        "sourceClass",
        "sourceRef",
        "contentHash",
        "rowCount",
        "positiveOutcomeCount",
        "retrieval",
        "coverage",
        "privacy",
        "fieldInventory"
      ],
      "properties": {
        "sourceId": { "$ref": "common.schema.json#/$defs/id" },
        "sourceRole": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "connectorType": {
          "type": "string",
          "enum": [
            "local_file",
            "manual_upload",
            "committed_fixture",
            "public_api",
            "private_api",
            "database",
            "agent_extraction"
          ]
        },
        "sourceClass": {
          "type": "string",
          "enum": [
            "official",
            "public_dataset",
            "internal_dataset",
            "human_judgment",
            "model_output",
            "market_price",
            "aggregate",
            "other"
          ]
        },
        "sourceRef": { "$ref": "#/$defs/nullableString" },
        "contentHash": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "rowCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "positiveOutcomeCount": { "$ref": "#/$defs/nullableInteger" },
        "retrieval": { "$ref": "#/$defs/retrieval" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "privacy": { "$ref": "#/$defs/privacy" },
        "featureSummary": { "$ref": "#/$defs/featureSummary" },
        "fieldInventory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": { "$ref": "#/$defs/fieldInventory" }
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrievedAt", "availableBeforeForecastClose", "maxSourceAgeHours"],
      "properties": {
        "retrievedAt": { "$ref": "#/$defs/nullableTimestamp" },
        "availableBeforeForecastClose": { "type": "boolean" },
        "maxSourceAgeHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8760
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geographies", "serviceDateStart", "serviceDateEnd", "entityIdentifiers"],
      "properties": {
        "geographies": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "serviceDateStart": { "$ref": "#/$defs/nullableDate" },
        "serviceDateEnd": { "$ref": "#/$defs/nullableDate" },
        "entityIdentifiers": {
          "type": "array",
          "maxItems": 80,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privacyClass",
        "containsSecrets",
        "containsPersonalData",
        "approvalRequired",
        "rawRetention"
      ],
      "properties": {
        "privacyClass": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "personal", "sensitive"]
        },
        "containsSecrets": { "type": "boolean" },
        "containsPersonalData": { "type": "boolean" },
        "approvalRequired": { "type": "boolean" },
        "rawRetention": {
          "type": "string",
          "enum": ["none", "metadata_only", "fixture_only", "full"]
        }
      }
    },
    "fieldInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldName", "observedType", "sampleCount", "nonNullCount", "exampleValuesStored"],
      "properties": {
        "fieldName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "observedType": {
          "type": "string",
          "enum": ["string", "integer", "number", "boolean", "date", "date_time", "categorical", "id", "unknown"]
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "nonNullCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "exampleValuesStored": { "type": "boolean" }
      }
    },
    "featureSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numericValues", "categoricalValues"],
      "properties": {
        "numericValues": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fieldName", "value", "unit"],
            "properties": {
              "fieldName": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
              },
              "value": { "type": "number" },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            }
          }
        },
        "categoricalValues": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fieldName", "value"],
            "properties": {
              "fieldName": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        }
      }
    }
  }
}
