{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/prediction-campaign-runner.schema.json",
  "title": "Prediction Campaign Runner",
  "description": "Checked local terminal runner readback for prediction campaigns before foreground execution creates forecast artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "predictionCampaignRunnerId",
    "generatedAt",
    "runnerStatus",
    "domain",
    "bindings",
    "commandSurface",
    "campaignCreationRequest",
    "forecastSchedule",
    "methodSelectionBinding",
    "preCalibration",
    "supportedRecurrenceModes",
    "runnerDecisions",
    "missedRunPolicy",
    "outputModes",
    "progress",
    "summary",
    "executionBoundary",
    "warnings"
  ],
  "properties": {
    "predictionCampaignRunnerId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "runnerStatus": {
      "type": "string",
      "enum": ["dry_run_ready_non_executing"]
    },
    "domain": { "$ref": "common.schema.json#/$defs/domain" },
    "bindings": { "$ref": "#/$defs/bindings" },
    "commandSurface": { "$ref": "#/$defs/commandSurface" },
    "campaignCreationRequest": { "$ref": "#/$defs/campaignCreationRequest" },
    "forecastSchedule": { "$ref": "#/$defs/forecastSchedule" },
    "methodSelectionBinding": { "$ref": "#/$defs/methodSelectionBinding" },
    "preCalibration": { "$ref": "#/$defs/preCalibration" },
    "supportedRecurrenceModes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/recurrenceMode" }
    },
    "runnerDecisions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/runnerDecision" }
    },
    "missedRunPolicy": { "$ref": "#/$defs/missedRunPolicy" },
    "outputModes": { "$ref": "#/$defs/outputModes" },
    "progress": { "$ref": "#/$defs/progress" },
    "summary": { "$ref": "#/$defs/summary" },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "warnings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/boundedString" }
    }
  },
  "$defs": {
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 720
    },
    "boundedStringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/boundedString" }
    },
    "optionalStringList": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/boundedString" }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predictionCampaignManifestId",
        "repeatingPredictionSetupId",
        "campaignId",
        "cycleId",
        "sourcePolicyId",
        "manifestPath"
      ],
      "properties": {
        "predictionCampaignManifestId": { "$ref": "common.schema.json#/$defs/id" },
        "repeatingPredictionSetupId": { "$ref": "common.schema.json#/$defs/id" },
        "campaignId": { "$ref": "common.schema.json#/$defs/id" },
        "cycleId": { "$ref": "common.schema.json#/$defs/id" },
        "sourcePolicyId": { "$ref": "common.schema.json#/$defs/id" },
        "manifestPath": { "$ref": "#/$defs/boundedString" }
      }
    },
    "commandSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "acceptsSetupJson",
        "acceptsManifestJson",
        "flags",
        "requiresExplicitLiveFetchFlag",
        "requiresExplicitResolverExecutionFlag",
        "defaultMissedRunPolicy"
      ],
      "properties": {
        "command": { "$ref": "#/$defs/boundedString" },
        "acceptsSetupJson": { "type": "boolean" },
        "acceptsManifestJson": { "type": "boolean" },
        "flags": { "$ref": "#/$defs/boundedStringList" },
        "requiresExplicitLiveFetchFlag": { "type": "boolean" },
        "requiresExplicitResolverExecutionFlag": { "type": "boolean" },
        "defaultMissedRunPolicy": { "$ref": "#/$defs/boundedString" }
      }
    },
    "campaignCreationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputMode",
        "setupJsonPath",
        "manifestJsonPath",
        "flagOverrides",
        "domain",
        "serviceWindow",
        "interval",
        "targetCount",
        "until",
        "calibrationTarget",
        "postCalibrationAction",
        "postCalibrationDelay",
        "candidatePlanCount",
        "liveWeatherRequested",
        "resolverExecutionRequested",
        "preCalibrationRequested",
        "historySourcePath",
        "acceptedForDryRun",
        "createsCampaignManifest",
        "writesCampaignState",
        "nextAction"
      ],
      "properties": {
        "inputMode": {
          "type": "string",
          "enum": ["default_fixture", "flag_overrides", "setup_json", "manifest_json"]
        },
        "setupJsonPath": { "$ref": "#/$defs/boundedString" },
        "manifestJsonPath": { "$ref": "#/$defs/boundedString" },
        "flagOverrides": { "$ref": "#/$defs/optionalStringList" },
        "domain": { "$ref": "common.schema.json#/$defs/domain" },
        "serviceWindow": { "$ref": "#/$defs/boundedString" },
        "interval": { "$ref": "#/$defs/boundedString" },
        "targetCount": { "$ref": "#/$defs/boundedString" },
        "until": { "$ref": "#/$defs/boundedString" },
        "calibrationTarget": { "$ref": "#/$defs/boundedString" },
        "postCalibrationAction": { "$ref": "#/$defs/boundedString" },
        "postCalibrationDelay": { "$ref": "#/$defs/boundedString" },
        "candidatePlanCount": { "$ref": "#/$defs/boundedString" },
        "liveWeatherRequested": { "type": "boolean" },
        "resolverExecutionRequested": { "type": "boolean" },
        "preCalibrationRequested": { "type": "boolean" },
        "historySourcePath": { "$ref": "#/$defs/boundedString" },
        "acceptedForDryRun": { "type": "boolean" },
        "createsCampaignManifest": { "type": "boolean" },
        "writesCampaignState": { "type": "boolean" },
        "nextAction": { "$ref": "#/$defs/boundedString" }
      }
    },
    "forecastSchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduleMode",
        "runnerClock",
        "tickPolicy",
        "readyRunId",
        "nextForecastCreateAt",
        "nextForecastCloseAt",
        "creationCommand",
        "capturedOutputMode",
        "scheduleRows",
        "normalChecksWriteLiveState",
        "requiresExplicitWriteLocal",
        "createsForecastArtifactsInDryRun",
        "nextAction"
      ],
      "properties": {
        "scheduleMode": { "$ref": "#/$defs/boundedString" },
        "runnerClock": { "$ref": "common.schema.json#/$defs/timestamp" },
        "tickPolicy": { "$ref": "#/$defs/boundedString" },
        "readyRunId": { "$ref": "common.schema.json#/$defs/id" },
        "nextForecastCreateAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "nextForecastCloseAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "creationCommand": { "$ref": "#/$defs/boundedString" },
        "capturedOutputMode": { "$ref": "#/$defs/boundedString" },
        "scheduleRows": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/forecastScheduleRow" }
        },
        "normalChecksWriteLiveState": { "type": "boolean" },
        "requiresExplicitWriteLocal": { "type": "boolean" },
        "createsForecastArtifactsInDryRun": { "type": "boolean" },
        "nextAction": { "$ref": "#/$defs/boundedString" }
      }
    },
    "methodSelectionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingStatus",
        "defaultMethodId",
        "activeMethodId",
        "candidateMethodId",
        "methodBindingPath",
        "applyCommand",
        "rollbackCommand",
        "requiresApprovedLocalBinding",
        "normalChecksReadLocalBinding",
        "normalChecksChangeMethod",
        "futureForecastsOnly",
        "priorForecastHistoryRewriteAllowed"
      ],
      "properties": {
        "bindingStatus": { "$ref": "#/$defs/boundedString" },
        "defaultMethodId": { "$ref": "common.schema.json#/$defs/id" },
        "activeMethodId": { "$ref": "common.schema.json#/$defs/id" },
        "candidateMethodId": { "$ref": "common.schema.json#/$defs/id" },
        "methodBindingPath": { "$ref": "#/$defs/boundedString" },
        "applyCommand": { "$ref": "#/$defs/boundedString" },
        "rollbackCommand": { "$ref": "#/$defs/boundedString" },
        "requiresApprovedLocalBinding": { "type": "boolean" },
        "normalChecksReadLocalBinding": { "type": "boolean" },
        "normalChecksChangeMethod": { "type": "boolean" },
        "futureForecastsOnly": { "type": "boolean" },
        "priorForecastHistoryRewriteAllowed": { "type": "boolean" }
      }
    },
    "forecastScheduleRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "decisionStatus",
        "scheduleAction",
        "forecastCreateAt",
        "forecastCloseAt",
        "createsForecastArtifacts",
        "writesCampaignState",
        "nextAction"
      ],
      "properties": {
        "runId": { "$ref": "common.schema.json#/$defs/id" },
        "decisionStatus": {
          "type": "string",
          "enum": [
            "ready_to_create_forecast",
            "wait_until_create_time",
            "skip_missed_close",
            "blocked_duplicate",
            "manual_stop_requested"
          ]
        },
        "scheduleAction": { "$ref": "#/$defs/boundedString" },
        "forecastCreateAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "forecastCloseAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "createsForecastArtifacts": { "type": "boolean" },
        "writesCampaignState": { "type": "boolean" },
        "nextAction": { "$ref": "#/$defs/boundedString" }
      }
    },
    "preCalibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestStatus",
        "preCalibrationStatus",
        "predictionCampaignPreCalibrationId",
        "historySourcePath",
        "resolvedOutcomeRowCount",
        "calibratedProbability",
        "activeMethodId",
        "preCalibrationArtifactPath",
        "methodBindingPath",
        "forecastProbabilitySource",
        "localWriteRequiredBeforeUse",
        "writesDuringDryRun",
        "qualityClaimAllowed",
        "nextAction"
      ],
      "properties": {
        "requestStatus": {
          "type": "string",
          "enum": ["not_requested", "requested"]
        },
        "preCalibrationStatus": {
          "type": "string",
          "enum": [
            "not_requested",
            "ready",
            "blocked_insufficient_historical_rows",
            "blocked_future_or_pilot_window_rows",
            "blocked_unresolved_historical_outcomes",
            "local_pre_calibration_completed",
            "local_pre_calibration_already_present"
          ]
        },
        "predictionCampaignPreCalibrationId": { "$ref": "#/$defs/boundedString" },
        "historySourcePath": { "$ref": "#/$defs/boundedString" },
        "resolvedOutcomeRowCount": { "type": "integer", "minimum": 0 },
        "calibratedProbability": { "type": "number", "minimum": 0, "maximum": 1 },
        "activeMethodId": { "$ref": "common.schema.json#/$defs/id" },
        "preCalibrationArtifactPath": { "$ref": "#/$defs/boundedString" },
        "methodBindingPath": { "$ref": "#/$defs/boundedString" },
        "forecastProbabilitySource": { "$ref": "#/$defs/boundedString" },
        "localWriteRequiredBeforeUse": { "type": "boolean" },
        "writesDuringDryRun": { "type": "boolean" },
        "qualityClaimAllowed": { "type": "boolean" },
        "nextAction": { "$ref": "#/$defs/boundedString" }
      }
    },
    "recurrenceMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "flagBinding", "supportedByDryRun", "createsForecastArtifacts"],
      "properties": {
        "mode": { "$ref": "#/$defs/boundedString" },
        "flagBinding": { "$ref": "#/$defs/boundedString" },
        "supportedByDryRun": { "type": "boolean" },
        "createsForecastArtifacts": { "type": "boolean" }
      }
    },
    "runnerDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "runId",
        "decisionStatus",
        "reason",
        "nextAction",
        "forecastArtifactsCreated",
        "liveFetchRequired",
        "resolverExecutionRequired",
        "writesLiveState"
      ],
      "properties": {
        "decisionId": { "$ref": "common.schema.json#/$defs/id" },
        "runId": { "$ref": "common.schema.json#/$defs/id" },
        "decisionStatus": {
          "type": "string",
          "enum": [
            "ready_to_create_forecast",
            "wait_until_create_time",
            "skip_missed_close",
            "blocked_duplicate",
            "manual_stop_requested"
          ]
        },
        "reason": { "$ref": "#/$defs/boundedString" },
        "nextAction": { "$ref": "#/$defs/boundedString" },
        "forecastArtifactsCreated": { "type": "boolean" },
        "liveFetchRequired": { "type": "boolean" },
        "resolverExecutionRequired": { "type": "boolean" },
        "writesLiveState": { "type": "boolean" }
      }
    },
    "missedRunPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyName",
        "defaultAction",
        "decisionStatus",
        "recordedRunStatus",
        "triggerCondition",
        "exclusionReasonCode",
        "excludedFromComparableEvidence",
        "createsForecastArtifacts",
        "createsResolutionArtifacts",
        "createsScoringRecords",
        "appendsCorpusEvidence",
        "nextAction"
      ],
      "properties": {
        "policyName": { "$ref": "#/$defs/boundedString" },
        "defaultAction": { "$ref": "#/$defs/boundedString" },
        "decisionStatus": {
          "type": "string",
          "enum": ["skip_missed_close"]
        },
        "recordedRunStatus": {
          "type": "string",
          "enum": ["missed"]
        },
        "triggerCondition": { "$ref": "#/$defs/boundedString" },
        "exclusionReasonCode": { "$ref": "#/$defs/boundedString" },
        "excludedFromComparableEvidence": { "type": "boolean" },
        "createsForecastArtifacts": { "type": "boolean" },
        "createsResolutionArtifacts": { "type": "boolean" },
        "createsScoringRecords": { "type": "boolean" },
        "appendsCorpusEvidence": { "type": "boolean" },
        "nextAction": { "$ref": "#/$defs/boundedString" }
      }
    },
    "outputModes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interactiveTerminalMode", "capturedStdoutMode", "jsonlExample", "humanLineExample"],
      "properties": {
        "interactiveTerminalMode": { "$ref": "#/$defs/boundedString" },
        "capturedStdoutMode": { "$ref": "#/$defs/boundedString" },
        "jsonlExample": { "$ref": "#/$defs/boundedString" },
        "humanLineExample": { "$ref": "#/$defs/boundedString" }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plannedRunCount",
        "readyToCreateForecastCount",
        "materializedRunCount",
        "forecastArtifactsCreated",
        "resolvedComparableOutcomes",
        "nextForecastRunId",
        "nextAction"
      ],
      "properties": {
        "plannedRunCount": { "type": "integer", "minimum": 0 },
        "readyToCreateForecastCount": { "type": "integer", "minimum": 0 },
        "materializedRunCount": { "type": "integer", "minimum": 0, "maximum": 100 },
        "forecastArtifactsCreated": { "type": "integer", "minimum": 0 },
        "resolvedComparableOutcomes": { "type": "integer", "minimum": 0 },
        "nextForecastRunId": { "$ref": "common.schema.json#/$defs/id" },
        "nextAction": { "$ref": "#/$defs/boundedString" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminalRunnerSurfaceImplemented",
        "dryRunOnly",
        "forecastCreationImplemented",
        "resolverExecutionImplemented",
        "writesLiveState",
        "normalChecksUseLiveNetwork",
        "preCalibrationImplemented",
        "qualityClaimAllowed",
        "recommendedNextMilestone"
      ],
      "properties": {
        "terminalRunnerSurfaceImplemented": { "type": "boolean" },
        "dryRunOnly": { "type": "boolean" },
        "forecastCreationImplemented": { "type": "boolean" },
        "resolverExecutionImplemented": { "type": "boolean" },
        "writesLiveState": { "type": "boolean" },
        "normalChecksUseLiveNetwork": { "type": "boolean" },
        "preCalibrationImplemented": { "type": "boolean" },
        "qualityClaimAllowed": { "type": "boolean" },
        "recommendedNextMilestone": { "$ref": "#/$defs/boundedString" }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readOnlyDryRun",
        "createsForecastArtifacts",
        "executesForecastRunner",
        "sleepsOrPolls",
        "writesIgnoredLiveState",
        "writesPreCalibrationState",
        "fetchesLiveData",
        "executesResolvers",
        "appendsCorpusEvidence",
        "storesCredentials",
        "storesPrivateRows",
        "hostedRuntimeAllowed",
        "qualityClaimAllowed"
      ],
      "properties": {
        "readOnlyDryRun": { "type": "boolean" },
        "createsForecastArtifacts": { "type": "boolean" },
        "executesForecastRunner": { "type": "boolean" },
        "sleepsOrPolls": { "type": "boolean" },
        "writesIgnoredLiveState": { "type": "boolean" },
        "writesPreCalibrationState": { "type": "boolean" },
        "fetchesLiveData": { "type": "boolean" },
        "executesResolvers": { "type": "boolean" },
        "appendsCorpusEvidence": { "type": "boolean" },
        "storesCredentials": { "type": "boolean" },
        "storesPrivateRows": { "type": "boolean" },
        "hostedRuntimeAllowed": { "type": "boolean" },
        "qualityClaimAllowed": { "type": "boolean" }
      }
    }
  }
}
