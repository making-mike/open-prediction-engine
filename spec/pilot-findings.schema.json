{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/pilot-findings.schema.json",
  "title": "Pilot Findings",
  "description": "Checked readback over sanitized real pilot-session evidence and current adoption friction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pilotFindingsId",
    "generatedAt",
    "findingsStatus",
    "realSessionCount",
    "simulatedAgentSessionCount",
    "minimumRealSessions",
    "targetRealSessions",
    "sourceRecords",
    "frictionSummary",
    "nextActions",
    "executionBoundary",
    "summary"
  ],
  "properties": {
    "pilotFindingsId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "findingsStatus": {
      "type": "string",
      "enum": ["real_sessions_needed", "agent_simulation_completed_real_sessions_needed", "ready_for_review", "findings_accepted"]
    },
    "realSessionCount": { "type": "integer", "minimum": 0 },
    "simulatedAgentSessionCount": { "type": "integer", "minimum": 0 },
    "minimumRealSessions": { "type": "integer", "minimum": 1 },
    "targetRealSessions": { "type": "integer", "minimum": 1 },
    "sourceRecords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pilotEvidenceLedgerId", "pilotSummaryIntakeId", "pilotSessionPacketId", "simulatedAgentPilotId"],
      "properties": {
        "pilotEvidenceLedgerId": { "$ref": "common.schema.json#/$defs/id" },
        "pilotSummaryIntakeId": { "$ref": "common.schema.json#/$defs/id" },
        "pilotSessionPacketId": { "$ref": "common.schema.json#/$defs/id" },
        "simulatedAgentPilotId": { "$ref": "common.schema.json#/$defs/id" }
      }
    },
    "frictionSummary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frictionClass", "syntheticSignalCount", "simulatedAgentSignalCount", "realSessionSignalCount", "interpretation"],
        "properties": {
          "frictionClass": { "type": "string", "minLength": 1, "maxLength": 120 },
          "syntheticSignalCount": { "type": "integer", "minimum": 0 },
          "simulatedAgentSignalCount": { "type": "integer", "minimum": 0 },
          "realSessionSignalCount": { "type": "integer", "minimum": 0 },
          "interpretation": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    },
    "nextActions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actionKey", "status", "command", "reason"],
        "properties": {
          "actionKey": { "type": "string", "minLength": 1, "maxLength": 120 },
          "status": { "type": "string", "minLength": 1, "maxLength": 120 },
          "command": { "type": "string", "minLength": 1, "maxLength": 240 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawTranscriptsStored",
        "privateDataStored",
        "credentialValuesStored",
        "hostProjectSecretsStored",
        "qualityClaimsUpgraded",
        "calibrationClaimsUpgraded",
        "hostedRuntimeUnblocked",
        "generatedTypesUnblocked"
      ],
      "properties": {
        "rawTranscriptsStored": { "type": "boolean" },
        "privateDataStored": { "type": "boolean" },
        "credentialValuesStored": { "type": "boolean" },
        "hostProjectSecretsStored": { "type": "boolean" },
        "qualityClaimsUpgraded": { "type": "boolean" },
        "calibrationClaimsUpgraded": { "type": "boolean" },
        "hostedRuntimeUnblocked": { "type": "boolean" },
        "generatedTypesUnblocked": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptedRealSessionCount",
        "acceptedSimulatedAgentSessionCount",
        "minimumRealSessions",
        "targetRealSessions",
        "agentSimulationEvidenceReady",
        "pilotEvidenceReady",
        "expansionEvidenceReady",
        "generatedTypesEvidenceReady",
        "qualityClaimAllowed",
        "hostedRuntimeAllowed"
      ],
      "properties": {
        "acceptedRealSessionCount": { "type": "integer", "minimum": 0 },
        "acceptedSimulatedAgentSessionCount": { "type": "integer", "minimum": 0 },
        "minimumRealSessions": { "type": "integer", "minimum": 1 },
        "targetRealSessions": { "type": "integer", "minimum": 1 },
        "agentSimulationEvidenceReady": { "type": "boolean" },
        "pilotEvidenceReady": { "type": "boolean" },
        "expansionEvidenceReady": { "type": "boolean" },
        "generatedTypesEvidenceReady": { "type": "boolean" },
        "qualityClaimAllowed": { "type": "boolean" },
        "hostedRuntimeAllowed": { "type": "boolean" }
      }
    }
  }
}
