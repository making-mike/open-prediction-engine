{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/forecast-card.schema.json",
  "title": "Forecast Card",
  "description": "Compact read-only forecast summary assembled from bound lifecycle records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cardId",
    "forecastId",
    "questionId",
    "title",
    "domain",
    "horizon",
    "status",
    "forecastedAt",
    "scheduledResolutionAt",
    "forecast",
    "baseline",
    "model",
    "resolution",
    "score",
    "qualityClaim",
    "requestBinding",
    "setupBinding",
    "warnings",
    "links"
  ],
  "properties": {
    "cardId": { "$ref": "common.schema.json#/$defs/id" },
    "forecastId": { "$ref": "common.schema.json#/$defs/id" },
    "questionId": { "$ref": "common.schema.json#/$defs/id" },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "domain": { "$ref": "common.schema.json#/$defs/domain" },
    "horizon": { "$ref": "common.schema.json#/$defs/horizon" },
    "status": {
      "type": "string",
      "enum": ["approved", "open", "closed", "resolved", "ambiguous", "annulled", "re_resolved"]
    },
    "forecastedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "closedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "scheduledResolutionAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "forecast": { "$ref": "common.schema.json#/$defs/forecastOutput" },
    "baseline": { "$ref": "common.schema.json#/$defs/forecastOutput" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelId", "version"],
      "properties": {
        "modelId": { "$ref": "common.schema.json#/$defs/id" },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "resolvedAt", "resolvedOutcome"],
      "properties": {
        "status": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["resolved", "ambiguous", "annulled", "disputed", "corrected", "stale_source"]
            },
            { "type": "null" }
          ]
        },
        "resolvedAt": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/timestamp" },
            { "type": "null" }
          ]
        },
        "resolvedOutcome": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/resolvedOutcome" },
            { "type": "null" }
          ]
        }
      }
    },
    "score": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scoreStatus", "scoringRule", "generatedAt"],
          "properties": {
            "scoreStatus": {
              "type": "string",
              "enum": ["scored", "excluded"]
            },
            "scoringRule": { "$ref": "common.schema.json#/$defs/scoringRule" },
            "primaryScore": { "type": "number" },
            "baselineScore": { "type": "number" },
            "baselineLift": { "type": "number" },
            "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
          }
        },
        { "type": "null" }
      ]
    },
    "qualityClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "minimumSampleSize",
        "resolvedComparableOutcomes",
        "sampleSize",
        "trackRecordReportId"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "minimumSampleSize": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            { "type": "null" }
          ]
        },
        "resolvedComparableOutcomes": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            { "type": "null" }
          ]
        },
        "sampleSize": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            { "type": "null" }
          ]
        },
        "trackRecordReportId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        }
      }
    },
    "requestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipelineRunId",
        "requestId",
        "effectfulGeneration",
        "executionMode",
        "sourceMode",
        "evidencePlanId",
        "evidenceSourceSetId",
        "sourcePolicyId"
      ],
      "properties": {
        "pipelineRunId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "requestId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "effectfulGeneration": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "executionMode": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["fixture_dry_run"]
            },
            { "type": "null" }
          ]
        },
        "sourceMode": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["committed_fixture", "auto_evidence_fixture_replay"]
            },
            { "type": "null" }
          ]
        },
        "evidencePlanId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "evidenceSourceSetId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "sourcePolicyId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        }
      }
    },
    "setupBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setupForecastRunId",
        "domainSetupId",
        "sourceManifestId",
        "fieldMappingId",
        "sourceIntakeReportId",
        "sourceIntakeHandoffId",
        "sourceHandoffMethodGateId",
        "setupMethodDecisionId",
        "setupBenchmarkGateId",
        "runStatus",
        "selectedMethodClass",
        "selectedForecastMode"
      ],
      "properties": {
        "setupForecastRunId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "domainSetupId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "sourceManifestId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "fieldMappingId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "sourceIntakeReportId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "sourceIntakeHandoffId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "sourceHandoffMethodGateId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "setupMethodDecisionId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "setupBenchmarkGateId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "runStatus": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["generated", "blocked"]
            },
            { "type": "null" }
          ]
        },
        "selectedMethodClass": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "historical_baseline",
                "historical_conditioned_frequency",
                "deterministic_statistical",
                "model_assisted",
                "external_reference",
                "ensemble",
                "none"
              ]
            },
            { "type": "null" }
          ]
        },
        "selectedForecastMode": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "baseline_only",
                "historical_conditioned",
                "deterministic_statistical",
                "model_assisted",
                "external_reference",
                "ensemble",
                "blocked"
              ]
            },
            { "type": "null" }
          ]
        }
      }
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forecastBundle",
        "evidenceTrace",
        "forecastArtifact",
        "evidencePacket",
        "resolutionRecord",
        "scoringReport",
        "trackRecordReport"
      ],
      "properties": {
        "forecastBundle": { "$ref": "common.schema.json#/$defs/id" },
        "evidenceTrace": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "forecastArtifact": { "$ref": "common.schema.json#/$defs/id" },
        "evidencePacket": { "$ref": "common.schema.json#/$defs/id" },
        "resolutionRecord": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "scoringReport": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "trackRecordReport": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
