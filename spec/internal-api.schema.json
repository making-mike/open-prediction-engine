{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/internal-api.schema.json",
  "title": "Embedded Internal API Surface",
  "description": "Stable embedded OPE API operation surface for host software and agents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "internalApiId",
    "generatedAt",
    "apiStatus",
    "designScope",
    "operationSurface",
    "adapterSurfaces",
    "requestEnvelope",
    "responseEnvelope",
    "nonInterferenceBoundary",
    "summary",
    "warnings"
  ],
  "properties": {
    "internalApiId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "apiStatus": { "type": "string", "enum": ["stable_surface_defined"] },
    "designScope": { "type": "string", "enum": ["embedded_internal_api"] },
    "operationSurface": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/internalApiOperation" }
    },
    "adapterSurfaces": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/adapterSurface" }
    },
    "requestEnvelope": { "$ref": "#/$defs/requestEnvelope" },
    "responseEnvelope": { "$ref": "#/$defs/responseEnvelope" },
    "nonInterferenceBoundary": { "$ref": "#/$defs/nonInterferenceBoundary" },
    "summary": { "$ref": "#/$defs/summary" },
    "warnings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 12, "maxLength": 220 }
    }
  },
  "$defs": {
    "internalApiOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationName",
        "operationKind",
        "implementationStatus",
        "sideEffectLevel",
        "inProcessFunctionName",
        "cliCommand",
        "agentCallOperation",
        "lifecycleOperations",
        "requiresOperationReceipt",
        "returnsOperationReceipt",
        "requiresIdempotencyKey",
        "requiresLease",
        "returnsReadModels",
        "returnsSanitizedDiagnostics",
        "rawFileLayoutExposed",
        "rawSqlExposed",
        "notes"
      ],
      "properties": {
        "operationName": {
          "type": "string",
          "enum": [
            "create_prediction",
            "update_prediction",
            "start_prediction",
            "pause_prediction",
            "resume_prediction",
            "run_tick",
            "resolve_due",
            "append_evidence",
            "read_status",
            "database_source_adapter_status",
            "read_forecast_card",
            "read_lifecycle_bundle",
            "archive_record",
            "redact_record"
          ]
        },
        "operationKind": { "type": "string", "enum": ["effectful", "read_only", "bounded_tick", "retention"] },
        "implementationStatus": {
          "type": "string",
          "enum": ["defined_surface", "mapped_to_existing_lifecycle_operation", "mapped_to_existing_read_surface"]
        },
        "sideEffectLevel": {
          "type": "string",
          "enum": ["receipt_backed_mutation", "read_only", "bounded_tick", "retention_mutation"]
        },
        "inProcessFunctionName": { "type": "string", "minLength": 3, "maxLength": 80 },
        "cliCommand": { "type": "string", "minLength": 8, "maxLength": 180 },
        "agentCallOperation": { "type": "string", "minLength": 3, "maxLength": 80 },
        "lifecycleOperations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": [
              "prediction.config_create",
              "prediction.config_update",
              "prediction.pause",
              "prediction.resume",
              "prediction.tick",
              "forecast.create",
              "resolution.record",
              "score.create",
              "evidence.append",
              "record.archive",
              "record.redact"
            ]
          }
        },
        "requiresOperationReceipt": { "type": "boolean" },
        "returnsOperationReceipt": { "type": "boolean" },
        "requiresIdempotencyKey": { "type": "boolean" },
        "requiresLease": { "type": "boolean" },
        "returnsReadModels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "enum": [
              "campaign_status",
              "next_due_forecast",
              "due_resolution_jobs",
              "unresolved_forecasts",
              "append_readiness",
              "calibration_status",
              "track_record_progress",
              "recovery_actions",
              "source_adapter_runtime_status",
              "forecast_card",
              "lifecycle_bundle"
            ]
          }
        },
        "returnsSanitizedDiagnostics": { "type": "boolean" },
        "rawFileLayoutExposed": { "type": "boolean" },
        "rawSqlExposed": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 12, "maxLength": 220 }
      }
    },
    "adapterSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapterName", "adapterStatus", "sharesInternalSemantics", "rawSqlExposed", "rawFileLayoutExposed", "notes"],
      "properties": {
        "adapterName": { "type": "string", "enum": ["in_process_python", "cli", "agent_call", "mcp_stdio", "http", "queue", "hosted_service"] },
        "adapterStatus": { "type": "string", "enum": ["defined_required", "planned_wrapper", "future_transport"] },
        "sharesInternalSemantics": { "type": "boolean" },
        "rawSqlExposed": { "type": "boolean" },
        "rawFileLayoutExposed": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 12, "maxLength": 220 }
      }
    },
    "requestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredFields", "optionalFields", "maxBytesRequired", "credentialValuesAllowed", "rawSqlAllowed", "rawPathMutationAllowed"],
      "properties": {
        "requiredFields": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 2, "maxLength": 80 }
        },
        "optionalFields": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 2, "maxLength": 80 }
        },
        "maxBytesRequired": { "type": "boolean" },
        "credentialValuesAllowed": { "type": "boolean" },
        "rawSqlAllowed": { "type": "boolean" },
        "rawPathMutationAllowed": { "type": "boolean" }
      }
    },
    "responseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredFields", "effectfulFields", "readOnlyFields", "sanitizedErrorsRequired", "responseTooLargeStatus"],
      "properties": {
        "requiredFields": {
          "type": "array",
          "minItems": 4,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 2, "maxLength": 80 }
        },
        "effectfulFields": {
          "type": "array",
          "minItems": 5,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 2, "maxLength": 80 }
        },
        "readOnlyFields": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 2, "maxLength": 80 }
        },
        "sanitizedErrorsRequired": { "type": "boolean" },
        "responseTooLargeStatus": { "type": "string", "enum": ["response_too_large"] }
      }
    },
    "nonInterferenceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surpriseNetworkCallsAllowed",
        "unboundedLoopsAllowed",
        "hiddenSchedulerInstallationAllowed",
        "automaticMethodUpgradesAllowed",
        "storesCredentialValues",
        "rawSqlExposed",
        "rawFileLayoutExposed",
        "hostedRuntimeRequired"
      ],
      "properties": {
        "surpriseNetworkCallsAllowed": { "type": "boolean" },
        "unboundedLoopsAllowed": { "type": "boolean" },
        "hiddenSchedulerInstallationAllowed": { "type": "boolean" },
        "automaticMethodUpgradesAllowed": { "type": "boolean" },
        "storesCredentialValues": { "type": "boolean" },
        "rawSqlExposed": { "type": "boolean" },
        "rawFileLayoutExposed": { "type": "boolean" },
        "hostedRuntimeRequired": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationCount",
        "effectfulOperationCount",
        "readOnlyOperationCount",
        "allEffectfulOperationsReceiptBacked",
        "allEffectfulOperationsIdempotent",
        "allEffectfulOperationsLeaseAware",
        "allEffectfulCallsReturnReceiptFields",
        "inProcessSurfaceDefined",
        "cliSurfaceDefined",
        "agentCallSurfaceDefined",
        "httpAndQueueAreFutureTransports",
        "hostedServiceIsFutureAdapter",
        "compactRequestResponseEnvelopesDefined",
        "nonInterferenceBoundaryDefined"
      ],
      "properties": {
        "operationCount": { "type": "integer", "minimum": 14, "maximum": 14 },
        "effectfulOperationCount": { "type": "integer", "minimum": 10, "maximum": 10 },
        "readOnlyOperationCount": { "type": "integer", "minimum": 4, "maximum": 4 },
        "allEffectfulOperationsReceiptBacked": { "type": "boolean" },
        "allEffectfulOperationsIdempotent": { "type": "boolean" },
        "allEffectfulOperationsLeaseAware": { "type": "boolean" },
        "allEffectfulCallsReturnReceiptFields": { "type": "boolean" },
        "inProcessSurfaceDefined": { "type": "boolean" },
        "cliSurfaceDefined": { "type": "boolean" },
        "agentCallSurfaceDefined": { "type": "boolean" },
        "httpAndQueueAreFutureTransports": { "type": "boolean" },
        "hostedServiceIsFutureAdapter": { "type": "boolean" },
        "compactRequestResponseEnvelopesDefined": { "type": "boolean" },
        "nonInterferenceBoundaryDefined": { "type": "boolean" }
      }
    }
  }
}
