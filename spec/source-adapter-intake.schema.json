{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/source-adapter-intake.schema.json",
  "title": "Source Adapter Intake",
  "description": "Checked intake matrix for external source-adapter outputs entering OPE source intake and method gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceAdapterIntakeId",
    "generatedAt",
    "domain",
    "intakeMode",
    "contractBindings",
    "intakeCases",
    "summary",
    "claimBoundary",
    "readSurface",
    "warnings"
  ],
  "properties": {
    "sourceAdapterIntakeId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "domain": { "$ref": "common.schema.json#/$defs/domain" },
    "intakeMode": {
      "type": "string",
      "enum": ["external_adapter_output_to_checked_intake"]
    },
    "contractBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceAdapterOutputSchema",
        "sourceManifestSchema",
        "fieldMappingSchema",
        "sourceIntakeReportSchema",
        "setupBenchmarkGateSchema",
        "setupMethodDecisionSchema",
        "existingTransitAdapterOutputPath"
      ],
      "properties": {
        "sourceAdapterOutputSchema": {
          "type": "string",
          "const": "spec/source-adapter-output.schema.json"
        },
        "sourceManifestSchema": {
          "type": "string",
          "const": "spec/source-manifest.schema.json"
        },
        "fieldMappingSchema": {
          "type": "string",
          "const": "spec/field-mapping.schema.json"
        },
        "sourceIntakeReportSchema": {
          "type": "string",
          "const": "spec/source-intake-report.schema.json"
        },
        "setupBenchmarkGateSchema": {
          "type": "string",
          "const": "spec/setup-benchmark-gate.schema.json"
        },
        "setupMethodDecisionSchema": {
          "type": "string",
          "const": "spec/setup-method-decision.schema.json"
        },
        "existingTransitAdapterOutputPath": { "$ref": "#/$defs/path" }
      }
    },
    "intakeCases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/intakeCase" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseCount",
        "acceptedCount",
        "needsConfirmationCount",
        "insufficientDataCount",
        "rejectedCount",
        "unsafeBlockedCount",
        "sourceIntakeReportsGenerated",
        "methodDecisionsGenerated"
      ],
      "properties": {
        "caseCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "acceptedCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "needsConfirmationCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "insufficientDataCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "rejectedCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "unsafeBlockedCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "sourceIntakeReportsGenerated": { "type": "integer", "minimum": 0, "maximum": 20 },
        "methodDecisionsGenerated": { "type": "integer", "minimum": 0, "maximum": 20 }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executesConnector",
        "fetchesLiveData",
        "storesCredentials",
        "acceptsPromptVisibleCredentials",
        "acceptsRawPrivateRows",
        "createsForecastArtifacts",
        "createsScoringRecords",
        "bypassesSourceIntake",
        "bypassesMethodGate",
        "claimsConnectorSafety"
      ],
      "properties": {
        "executesConnector": { "type": "boolean" },
        "fetchesLiveData": { "type": "boolean" },
        "storesCredentials": { "type": "boolean" },
        "acceptsPromptVisibleCredentials": { "type": "boolean" },
        "acceptsRawPrivateRows": { "type": "boolean" },
        "createsForecastArtifacts": { "type": "boolean" },
        "createsScoringRecords": { "type": "boolean" },
        "bypassesSourceIntake": { "type": "boolean" },
        "bypassesMethodGate": { "type": "boolean" },
        "claimsConnectorSafety": { "type": "boolean" }
      }
    },
    "readSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "normalChecksOffline",
        "mutatesExternalSystems",
        "requiresCredentials",
        "writesOnlyGeneratedFixtures"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "normalChecksOffline": { "type": "boolean" },
        "mutatesExternalSystems": { "type": "boolean" },
        "requiresCredentials": { "type": "boolean" },
        "writesOnlyGeneratedFixtures": { "type": "boolean" }
      }
    },
    "warnings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 260
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 3,
      "maxLength": 260
    },
    "nullableId": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/id" },
        { "type": "null" }
      ]
    },
    "nullablePath": {
      "oneOf": [
        { "$ref": "#/$defs/path" },
        { "type": "null" }
      ]
    },
    "nullableStatus": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        { "type": "null" }
      ]
    },
    "adapterIntakeStatus": {
      "type": "string",
      "enum": ["accepted", "needs_confirmation", "insufficient_data", "rejected", "unsafe_blocked"]
    },
    "nextAction": {
      "type": "string",
      "enum": [
        "proceed_to_method_gating",
        "ask_mapping_confirmation",
        "collect_more_data",
        "replace_source",
        "stop_unsafe_connector"
      ]
    },
    "methodGateStatus": {
      "type": "string",
      "enum": [
        "method_selected",
        "baseline_selected",
        "needs_mapping_confirmation",
        "needs_more_data",
        "rejected",
        "blocked_unsafe",
        "not_entered_source_intake"
      ]
    },
    "sourceKind": {
      "type": "string",
      "enum": [
        "local_file",
        "manual_upload",
        "public_api",
        "private_api",
        "private_database",
        "saas",
        "mcp_tool",
        "agent_extraction"
      ]
    },
    "intakeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "case",
        "sourceAdapterOutputId",
        "sourceAdapterOutputPath",
        "outputStatus",
        "sourceKind",
        "implementationLocation",
        "executionMode",
        "validationSummary",
        "intakeRoute",
        "methodGateSummary",
        "generatedArtifacts",
        "rejectionReasons",
        "requiredActions"
      ],
      "properties": {
        "caseId": { "$ref": "common.schema.json#/$defs/id" },
        "case": { "$ref": "#/$defs/adapterIntakeStatus" },
        "sourceAdapterOutputId": { "$ref": "common.schema.json#/$defs/id" },
        "sourceAdapterOutputPath": { "$ref": "#/$defs/path" },
        "outputStatus": {
          "type": "string",
          "enum": ["intake_ready", "needs_confirmation", "rejected", "runtime_not_implemented"]
        },
        "sourceKind": { "$ref": "#/$defs/sourceKind" },
        "implementationLocation": {
          "type": "string",
          "enum": ["external_agent", "ope_core_fixture"]
        },
        "executionMode": {
          "type": "string",
          "enum": ["fixture_replay", "caller_approved_local", "external_runtime_capture", "planned_runtime"]
        },
        "validationSummary": { "$ref": "#/$defs/validationSummary" },
        "intakeRoute": { "$ref": "#/$defs/intakeRoute" },
        "methodGateSummary": { "$ref": "#/$defs/methodGateSummary" },
        "generatedArtifacts": { "$ref": "#/$defs/generatedArtifacts" },
        "rejectionReasons": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          }
        },
        "requiredActions": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 260
          }
        }
      }
    },
    "validationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceAdapterOutputSchemaValid",
        "manifestValid",
        "fieldMappingValid",
        "provenanceSummaryValid",
        "sourceRolesValid",
        "freshnessValid",
        "leakageStatus",
        "credentialBoundaryStatus",
        "rawRowsIncluded",
        "allEvidenceClaimed"
      ],
      "properties": {
        "sourceAdapterOutputSchemaValid": { "type": "boolean" },
        "manifestValid": { "type": "boolean" },
        "fieldMappingValid": { "type": "boolean" },
        "provenanceSummaryValid": { "type": "boolean" },
        "sourceRolesValid": { "type": "boolean" },
        "freshnessValid": { "type": "boolean" },
        "leakageStatus": {
          "type": "string",
          "enum": ["passed", "failed", "blocked_before_intake"]
        },
        "credentialBoundaryStatus": {
          "type": "string",
          "enum": ["passed", "failed", "blocked_before_intake"]
        },
        "rawRowsIncluded": { "type": "boolean" },
        "allEvidenceClaimed": { "type": "boolean" }
      }
    },
    "intakeRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canEnterSourceIntake",
        "sourceIntakeReportId",
        "sourceIntakeStatus",
        "adapterIntakeStatus",
        "nextAction"
      ],
      "properties": {
        "canEnterSourceIntake": { "type": "boolean" },
        "sourceIntakeReportId": { "$ref": "#/$defs/nullableId" },
        "sourceIntakeStatus": { "$ref": "#/$defs/nullableStatus" },
        "adapterIntakeStatus": { "$ref": "#/$defs/adapterIntakeStatus" },
        "nextAction": { "$ref": "#/$defs/nextAction" }
      }
    },
    "methodGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setupBenchmarkGateId",
        "setupMethodDecisionId",
        "methodGateStatus",
        "selectedMethodClass",
        "forecastArtifactsCreated",
        "qualityClaimAllowed"
      ],
      "properties": {
        "setupBenchmarkGateId": { "$ref": "#/$defs/nullableId" },
        "setupMethodDecisionId": { "$ref": "#/$defs/nullableId" },
        "methodGateStatus": { "$ref": "#/$defs/methodGateStatus" },
        "selectedMethodClass": { "$ref": "#/$defs/nullableStatus" },
        "forecastArtifactsCreated": { "type": "boolean" },
        "qualityClaimAllowed": { "type": "boolean" }
      }
    },
    "generatedArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceAdapterOutput",
        "sourceIntakeReport",
        "setupBenchmarkGate",
        "setupMethodDecision"
      ],
      "properties": {
        "sourceAdapterOutput": { "$ref": "#/$defs/path" },
        "sourceIntakeReport": { "$ref": "#/$defs/nullablePath" },
        "setupBenchmarkGate": { "$ref": "#/$defs/nullablePath" },
        "setupMethodDecision": { "$ref": "#/$defs/nullablePath" }
      }
    }
  }
}
