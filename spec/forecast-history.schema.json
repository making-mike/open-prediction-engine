{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/forecast-history.schema.json",
  "title": "Forecast History",
  "description": "Timestamped forecast states for one question.",
  "type": "object",
  "additionalProperties": false,
  "required": ["historyId", "questionId", "entries", "createdAt", "updatedAt"],
  "properties": {
    "historyId": { "$ref": "common.schema.json#/$defs/id" },
    "questionId": { "$ref": "common.schema.json#/$defs/id" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "forecastId",
          "forecastedAt",
          "state",
          "sourceClass",
          "forecastOutput"
        ],
        "properties": {
          "forecastId": { "$ref": "common.schema.json#/$defs/id" },
          "forecastedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "withdrawn",
              "superseded",
              "reaffirmed",
              "benchmark_hidden",
              "analysis_only"
            ]
          },
          "sourceClass": {
            "type": "string",
            "enum": ["baseline", "model", "human", "market", "aggregate"]
          },
          "model": { "$ref": "common.schema.json#/$defs/modelIdentity" },
          "forecastOutput": { "$ref": "common.schema.json#/$defs/forecastOutput" },
          "supersedesForecastId": { "$ref": "common.schema.json#/$defs/id" },
          "rationaleSummary": {
            "type": "string",
            "maxLength": 1200
          },
          "evidencePacketId": { "$ref": "common.schema.json#/$defs/id" }
        }
      }
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
