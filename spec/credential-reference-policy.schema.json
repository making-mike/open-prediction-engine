{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/credential-reference-policy.schema.json",
  "title": "Credential Reference Policy",
  "description": "Checked policy for caller-owned credential references used by private API and database source bindings without storing secrets in OPE records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credentialReferencePolicyId",
    "generatedAt",
    "policyStatus",
    "decisionStatus",
    "normalChecksMutateState",
    "secretResolverImplemented",
    "sourceBinding",
    "acceptedReferenceMechanisms",
    "requiredScopeKeys",
    "lifecycleStates",
    "consumerRules",
    "credentialReferenceCases",
    "readbacks",
    "executionBoundary",
    "summary",
    "warnings"
  ],
  "properties": {
    "credentialReferencePolicyId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "policyStatus": { "type": "string", "enum": ["credential_reference_policy_checked"] },
    "decisionStatus": {
      "type": "string",
      "enum": ["opaque_caller_owned_references_scoped_to_workspace_source_and_adapter"]
    },
    "normalChecksMutateState": { "type": "boolean" },
    "secretResolverImplemented": { "type": "boolean" },
    "sourceBinding": { "$ref": "#/$defs/sourceBinding" },
    "acceptedReferenceMechanisms": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/referenceMechanism" }
    },
    "requiredScopeKeys": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/scopeKey" }
    },
    "lifecycleStates": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/lifecycleState" }
    },
    "consumerRules": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/consumerRule" }
    },
    "credentialReferenceCases": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/policyCase" }
    },
    "readbacks": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/readback" }
    },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "summary": { "$ref": "#/$defs/summary" },
    "warnings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 8, "maxLength": 280 }
    }
  },
  "$defs": {
    "sourceKind": {
      "type": "string",
      "enum": ["fixture", "local_file", "source_adapter_output", "api", "database"]
    },
    "mechanismName": {
      "type": "string",
      "enum": [
        "caller_secret_store_alias",
        "host_runtime_secret_handle",
        "local_operator_session_ref",
        "public_no_credential"
      ]
    },
    "scopeKeyName": {
      "type": "string",
      "enum": [
        "tenant_id",
        "workspace_id",
        "source_binding_id",
        "source_role",
        "adapter_ref",
        "source_kind",
        "source_policy_id",
        "credential_purpose"
      ]
    },
    "lifecycleStateName": {
      "type": "string",
      "enum": [
        "proposed",
        "approved",
        "active",
        "rotation_due",
        "revoked",
        "redaction_required"
      ]
    },
    "consumerName": {
      "type": "string",
      "enum": [
        "private_api_adapter",
        "database_adapter",
        "source_binding_validation",
        "runtime_readback",
        "agent_envelope",
        "normal_checks"
      ]
    },
    "policyCaseName": {
      "type": "string",
      "enum": [
        "accepted_private_api_reference",
        "accepted_database_reference",
        "public_source_no_credential",
        "missing_reference_for_private_api",
        "raw_api_token_submitted",
        "database_password_in_connection_string",
        "cross_tenant_reference",
        "unscoped_reference",
        "adapter_mismatch",
        "revoked_reference",
        "normal_check_resolution_attempt"
      ]
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceBindingCommand",
        "databaseRuntimeCommand",
        "sourceBindingCaseCount",
        "databaseRuntimeCaseCount",
        "privateSourceKindsRequiringCredentialRef",
        "rawCredentialValuesRead",
        "notes"
      ],
      "properties": {
        "sourceBindingCommand": { "type": "string", "minLength": 8, "maxLength": 180 },
        "databaseRuntimeCommand": { "type": "string", "minLength": 8, "maxLength": 180 },
        "sourceBindingCaseCount": { "type": "integer", "minimum": 0 },
        "databaseRuntimeCaseCount": { "type": "integer", "minimum": 0 },
        "privateSourceKindsRequiringCredentialRef": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/sourceKind" }
        },
        "rawCredentialValuesRead": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 8, "maxLength": 260 }
      }
    },
    "referenceMechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanismName",
        "mechanismStatus",
        "allowedForSourceKinds",
        "requiredScopeKeys",
        "callerApprovalRequired",
        "rotationSupported",
        "revocationSupported",
        "secretValueStored",
        "secretLookupDuringNormalChecks",
        "promptVisibleSecretAllowed",
        "notes",
        "safeNextAction"
      ],
      "properties": {
        "mechanismName": { "$ref": "#/$defs/mechanismName" },
        "mechanismStatus": { "type": "string", "enum": ["accepted_reference_mechanism"] },
        "allowedForSourceKinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/sourceKind" }
        },
        "requiredScopeKeys": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/scopeKeyName" }
        },
        "callerApprovalRequired": { "type": "boolean" },
        "rotationSupported": { "type": "boolean" },
        "revocationSupported": { "type": "boolean" },
        "secretValueStored": { "type": "boolean" },
        "secretLookupDuringNormalChecks": { "type": "boolean" },
        "promptVisibleSecretAllowed": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 8, "maxLength": 280 },
        "safeNextAction": { "type": "string", "minLength": 8, "maxLength": 220 }
      }
    },
    "scopeKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeKeyName",
        "requiredForPrivateApi",
        "requiredForDatabase",
        "containsSecretMaterial",
        "prevents",
        "safeNextAction"
      ],
      "properties": {
        "scopeKeyName": { "$ref": "#/$defs/scopeKeyName" },
        "requiredForPrivateApi": { "type": "boolean" },
        "requiredForDatabase": { "type": "boolean" },
        "containsSecretMaterial": { "type": "boolean" },
        "prevents": { "type": "string", "minLength": 8, "maxLength": 220 },
        "safeNextAction": { "type": "string", "minLength": 8, "maxLength": 220 }
      }
    },
    "lifecycleState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stateName",
        "stateStatus",
        "allowsRuntimeUse",
        "allowsNormalCheckSecretResolution",
        "requiresApprovalReceipt",
        "requiresRedactionReceipt",
        "credentialValuesStored",
        "safeNextAction"
      ],
      "properties": {
        "stateName": { "$ref": "#/$defs/lifecycleStateName" },
        "stateStatus": {
          "type": "string",
          "enum": [
            "waiting_for_approval",
            "approved_not_resolved",
            "runtime_use_allowed_when_explicit",
            "rotation_required",
            "blocked_revoked",
            "blocked_redaction_required"
          ]
        },
        "allowsRuntimeUse": { "type": "boolean" },
        "allowsNormalCheckSecretResolution": { "type": "boolean" },
        "requiresApprovalReceipt": { "type": "boolean" },
        "requiresRedactionReceipt": { "type": "boolean" },
        "credentialValuesStored": { "type": "boolean" },
        "safeNextAction": { "type": "string", "minLength": 8, "maxLength": 220 }
      }
    },
    "consumerRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumerName",
        "mayUseCredentialReference",
        "canResolveSecretInNormalChecks",
        "canReceiveCredentialValue",
        "requiresScopeMatch",
        "requiresAdapterMatch",
        "requiresApproval",
        "allowedOperations",
        "notes"
      ],
      "properties": {
        "consumerName": { "$ref": "#/$defs/consumerName" },
        "mayUseCredentialReference": { "type": "boolean" },
        "canResolveSecretInNormalChecks": { "type": "boolean" },
        "canReceiveCredentialValue": { "type": "boolean" },
        "requiresScopeMatch": { "type": "boolean" },
        "requiresAdapterMatch": { "type": "boolean" },
        "requiresApproval": { "type": "boolean" },
        "allowedOperations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 4, "maxLength": 80 }
        },
        "notes": { "type": "string", "minLength": 8, "maxLength": 260 }
      }
    },
    "policyCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseName",
        "caseStatus",
        "sourceKind",
        "referenceInputClass",
        "sourceBindingAccepted",
        "canEnterAdapterRuntime",
        "credentialValuesStored",
        "secretResolvedInNormalChecks",
        "crossTenantReuseAllowed",
        "sanitizedDiagnosticsOnly",
        "nextAction"
      ],
      "properties": {
        "caseName": { "$ref": "#/$defs/policyCaseName" },
        "caseStatus": {
          "type": "string",
          "enum": [
            "accepted_private_api_reference",
            "accepted_database_reference",
            "accepted_public_no_credential",
            "blocked_missing_credential_reference",
            "blocked_raw_api_token",
            "blocked_database_password_connection_string",
            "blocked_cross_tenant_reference",
            "blocked_unscoped_reference",
            "blocked_adapter_mismatch",
            "blocked_revoked_reference",
            "blocked_normal_check_secret_resolution"
          ]
        },
        "sourceKind": { "$ref": "#/$defs/sourceKind" },
        "referenceInputClass": {
          "type": "string",
          "enum": [
            "opaque_reference",
            "none_public_source",
            "missing_reference",
            "raw_secret_value",
            "raw_connection_string",
            "wrong_scope",
            "unscoped_reference",
            "wrong_adapter",
            "revoked_reference",
            "secret_resolution_request"
          ]
        },
        "sourceBindingAccepted": { "type": "boolean" },
        "canEnterAdapterRuntime": { "type": "boolean" },
        "credentialValuesStored": { "type": "boolean" },
        "secretResolvedInNormalChecks": { "type": "boolean" },
        "crossTenantReuseAllowed": { "type": "boolean" },
        "sanitizedDiagnosticsOnly": { "type": "boolean" },
        "nextAction": { "type": "string", "minLength": 8, "maxLength": 220 }
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readbackSurface",
        "command",
        "mutatesState",
        "resolvesSecrets",
        "credentialValuesReturned",
        "notes"
      ],
      "properties": {
        "readbackSurface": {
          "type": "string",
          "enum": [
            "cli",
            "source_bindings",
            "domain_source_field_policy",
            "database_source_adapter_runtime",
            "runtime_security",
            "workspace_tenant_isolation",
            "agent_adapter_dispatcher"
          ]
        },
        "command": { "type": "string", "minLength": 8, "maxLength": 180 },
        "mutatesState": { "type": "boolean" },
        "resolvesSecrets": { "type": "boolean" },
        "credentialValuesReturned": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 8, "maxLength": 260 }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalChecksResolveSecrets",
        "storesCredentialValues",
        "printsCredentialValues",
        "readsEnvironmentSecrets",
        "writesSecretStore",
        "crossTenantCredentialReuseAllowed",
        "unscopedReferencesAllowed",
        "rawConnectionStringsAllowed",
        "databaseConnectionsOpened",
        "apiCallsExecuted",
        "hostedSecretManagerImplemented",
        "qualityClaimsUpgraded"
      ],
      "properties": {
        "normalChecksResolveSecrets": { "type": "boolean" },
        "storesCredentialValues": { "type": "boolean" },
        "printsCredentialValues": { "type": "boolean" },
        "readsEnvironmentSecrets": { "type": "boolean" },
        "writesSecretStore": { "type": "boolean" },
        "crossTenantCredentialReuseAllowed": { "type": "boolean" },
        "unscopedReferencesAllowed": { "type": "boolean" },
        "rawConnectionStringsAllowed": { "type": "boolean" },
        "databaseConnectionsOpened": { "type": "boolean" },
        "apiCallsExecuted": { "type": "boolean" },
        "hostedSecretManagerImplemented": { "type": "boolean" },
        "qualityClaimsUpgraded": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptedReferenceMechanismCount",
        "requiredScopeKeyCount",
        "lifecycleStateCount",
        "consumerRuleCount",
        "credentialReferenceCaseCount",
        "blockedCaseCount",
        "normalChecksResolveSecrets",
        "secretResolverImplemented"
      ],
      "properties": {
        "acceptedReferenceMechanismCount": { "type": "integer", "minimum": 0 },
        "requiredScopeKeyCount": { "type": "integer", "minimum": 0 },
        "lifecycleStateCount": { "type": "integer", "minimum": 0 },
        "consumerRuleCount": { "type": "integer", "minimum": 0 },
        "credentialReferenceCaseCount": { "type": "integer", "minimum": 0 },
        "blockedCaseCount": { "type": "integer", "minimum": 0 },
        "normalChecksResolveSecrets": { "type": "boolean" },
        "secretResolverImplemented": { "type": "boolean" }
      }
    }
  }
}
