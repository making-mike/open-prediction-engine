{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/release-manifest.schema.json",
  "title": "Release Manifest",
  "description": "Machine-readable summary of the local OPE release surface.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "releaseManifestId",
    "generatedAt",
    "project",
    "releaseStatus",
    "ci",
    "commands",
    "contracts",
    "readSurfaces",
    "mvpLocalRuntime",
    "claimBoundaries",
    "nonGoals"
  ],
  "properties": {
    "releaseManifestId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "runtime", "packageManager"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "packageManager": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "releaseStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "networkApiImplemented",
        "hostedServiceImplemented",
        "liveCalibrationClaimAllowed"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["fixture_ready"]
        },
        "networkApiImplemented": { "type": "boolean" },
        "hostedServiceImplemented": { "type": "boolean" },
        "liveCalibrationClaimAllowed": { "type": "boolean" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setupCheck", "test", "releaseCheck", "cli"],
      "properties": {
        "setupCheck": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "test": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "releaseCheck": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "cli": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "workflowPath", "releaseCheckCommand", "compileCommand"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["github_actions"]
        },
        "workflowPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "releaseCheckCommand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "compileCommand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaFileCount", "schemaFiles"],
      "properties": {
        "schemaFileCount": {
          "type": "integer",
          "minimum": 1
        },
        "schemaFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "readSurfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recordType", "count"],
        "properties": {
          "recordType": {
            "type": "string",
            "enum": [
              "evidence-source-set",
              "evidence-trace",
              "forecast-artifact",
              "forecast-bundle",
              "forecast-card",
              "source-connector-results",
              "track-record"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "mvpLocalRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaceStatus",
        "runtimeMode",
        "runbookPath",
        "supportedSourceInputs",
        "happyPath",
        "machineInterfaces",
        "smokeChecks",
        "blockedPathExamples",
        "claimReview"
      ],
      "properties": {
        "surfaceStatus": {
          "type": "string",
          "enum": ["local_mvp_fixture_ready"]
        },
        "runtimeMode": {
          "type": "string",
          "enum": ["local_cli_and_generated_records"]
        },
        "runbookPath": { "$ref": "#/$defs/boundedString" },
        "supportedSourceInputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "enum": [
              "approved_local_csv_json",
              "approved_local_folder_runtime",
              "accepted_source_adapter_output",
              "committed_fixture_request",
              "policy_bound_promoted_fixture_source_set"
            ]
          }
        },
        "happyPath": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "setupCommand",
            "forecastCommand",
            "readbackCommands",
            "resolutionCommand",
            "scoringCommand",
            "corpusReadbackCommand",
            "failureRecoveryCommand",
            "expectedForecastIds"
          ],
          "properties": {
            "setupCommand": { "$ref": "#/$defs/boundedString" },
            "forecastCommand": { "$ref": "#/$defs/boundedString" },
            "readbackCommands": {
              "type": "array",
              "minItems": 1,
              "maxItems": 13,
              "items": { "$ref": "#/$defs/boundedString" }
            },
            "resolutionCommand": { "$ref": "#/$defs/boundedString" },
            "scoringCommand": { "$ref": "#/$defs/boundedString" },
            "corpusReadbackCommand": { "$ref": "#/$defs/boundedString" },
            "failureRecoveryCommand": { "$ref": "#/$defs/boundedString" },
            "expectedForecastIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": { "$ref": "common.schema.json#/$defs/id" }
            }
          }
        },
        "machineInterfaces": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/machineInterface" }
        },
        "smokeChecks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 15,
          "items": { "$ref": "#/$defs/smokeCheck" }
        },
        "blockedPathExamples": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/blockedPathExample" }
        },
        "claimReview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "qualityClaimsAllowed",
            "trackRecordStatus",
            "calibrationStatus",
            "liveCalibrationClaimAllowed",
            "normalChecksUseLiveNetwork",
            "nonGoalRefs"
          ],
          "properties": {
            "qualityClaimsAllowed": { "type": "boolean" },
            "trackRecordStatus": { "$ref": "#/$defs/boundedString" },
            "calibrationStatus": { "$ref": "#/$defs/boundedString" },
            "liveCalibrationClaimAllowed": { "type": "boolean" },
            "normalChecksUseLiveNetwork": { "type": "boolean" },
            "nonGoalRefs": {
              "type": "array",
              "minItems": 4,
              "maxItems": 16,
              "items": { "$ref": "#/$defs/boundedString" }
            }
          }
        }
      }
    },
    "claimBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "minimumCalibrationSampleSize",
        "resolvedPipelineOutcomes",
        "resolvedLiveOutcomes",
        "resolvedAutoEvidenceOutcomes",
        "resolvedSourceHandoffOutcomes",
        "qualityClaimStatus"
      ],
      "properties": {
        "domain": { "$ref": "common.schema.json#/$defs/domain" },
        "minimumCalibrationSampleSize": {
          "type": "integer",
          "minimum": 1
        },
        "resolvedPipelineOutcomes": {
          "type": "integer",
          "minimum": 0
        },
        "resolvedLiveOutcomes": {
          "type": "integer",
          "minimum": 0
        },
        "resolvedAutoEvidenceOutcomes": {
          "type": "integer",
          "minimum": 0
        },
        "resolvedSourceHandoffOutcomes": {
          "type": "integer",
          "minimum": 0
        },
        "qualityClaimStatus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "nonGoals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    }
  },
  "$defs": {
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260
    },
    "machineInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "command", "status", "minimumUse"],
      "properties": {
        "interface": {
          "type": "string",
          "enum": ["cli", "agent_call", "mcp_stdio"]
        },
        "command": { "$ref": "#/$defs/boundedString" },
        "status": {
          "type": "string",
          "enum": ["implemented_local", "local_scaffold"]
        },
        "minimumUse": { "$ref": "#/$defs/boundedString" }
      }
    },
    "smokeCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "command", "expected"],
      "properties": {
        "checkId": { "$ref": "#/$defs/boundedString" },
        "command": { "$ref": "#/$defs/boundedString" },
        "expected": { "$ref": "#/$defs/boundedString" }
      }
    },
    "blockedPathExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "command", "expectedStatus", "nextAction", "forecastArtifactsCreated"],
      "properties": {
        "case": { "$ref": "#/$defs/boundedString" },
        "command": { "$ref": "#/$defs/boundedString" },
        "expectedStatus": { "$ref": "#/$defs/boundedString" },
        "nextAction": { "$ref": "#/$defs/boundedString" },
        "forecastArtifactsCreated": { "type": "boolean" }
      }
    }
  }
}
