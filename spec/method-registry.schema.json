{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/method-registry.schema.json",
  "title": "Method Registry",
  "description": "Forecasting method registry with benchmark and claim boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "methodRegistryId",
    "generatedAt",
    "domain",
    "methods",
    "selectionPolicy"
  ],
  "properties": {
    "methodRegistryId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "domain": { "$ref": "common.schema.json#/$defs/domain" },
    "methods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "methodId",
          "methodClass",
          "status",
          "model",
          "compatibleDomains",
          "inputs",
          "uncertaintyMethod",
          "knownLimitations",
          "benchmarkStatus"
        ],
        "properties": {
          "methodId": { "$ref": "common.schema.json#/$defs/id" },
          "methodClass": {
            "type": "string",
            "enum": [
              "baseline",
              "deterministic_statistical",
              "model_assisted",
              "retrieval_assisted",
              "ensemble",
              "external_reference"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["enabled", "proposed", "disabled"]
          },
          "model": { "$ref": "common.schema.json#/$defs/modelIdentity" },
          "compatibleDomains": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["domain", "horizonBuckets", "outputTypes"],
              "properties": {
                "domain": { "$ref": "common.schema.json#/$defs/domain" },
                "horizonBuckets": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "outputTypes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": { "$ref": "common.schema.json#/$defs/outputType" }
                }
              }
            }
          },
          "inputs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inputSourceClasses",
              "requiredConnectors",
              "usesRetrievedEvidence",
              "requiresBaseline",
              "requiresTrainingData"
            ],
            "properties": {
              "inputSourceClasses": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "enum": [
                    "official",
                    "public_dataset",
                    "internal_dataset",
                    "human_judgment",
                    "model_output",
                    "market_price",
                    "aggregate",
                    "other"
                  ]
                }
              },
              "requiredConnectors": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 80
                }
              },
              "usesRetrievedEvidence": { "type": "boolean" },
              "requiresBaseline": { "type": "boolean" },
              "requiresTrainingData": { "type": "boolean" }
            }
          },
          "uncertaintyMethod": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "description"],
            "properties": {
              "method": {
                "type": "string",
                "minLength": 3,
                "maxLength": 120
              },
              "description": {
                "type": "string",
                "minLength": 3,
                "maxLength": 500
              }
            }
          },
          "knownLimitations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 240
            }
          },
          "benchmarkStatus": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "qualityClaimStatus"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["not_required", "benchmarked", "not_benchmarked"]
              },
              "qualityClaimStatus": {
                "type": "string",
                "minLength": 3,
                "maxLength": 160
              },
              "comparableBenchmarkRunIds": {
                "type": "array",
                "maxItems": 12,
                "items": { "$ref": "common.schema.json#/$defs/id" }
              },
              "baselineMethodId": { "$ref": "common.schema.json#/$defs/id" },
              "baselineBenchmarkRunId": { "$ref": "common.schema.json#/$defs/id" },
              "candidateBenchmarkRunId": { "$ref": "common.schema.json#/$defs/id" },
              "sameSourcePolicy": { "type": "boolean" },
              "sameRetrievalWindow": { "type": "boolean" },
              "leakageValidated": { "type": "boolean" },
              "sampleSize": {
                "type": "integer",
                "minimum": 0
              },
              "baselineLift": { "type": "number" }
            }
          }
        }
      }
    },
    "selectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultMethodId",
        "fallbackMethodId",
        "minimumComparableBenchmarks",
        "insufficientEvidenceRule"
      ],
      "properties": {
        "defaultMethodId": { "$ref": "common.schema.json#/$defs/id" },
        "fallbackMethodId": { "$ref": "common.schema.json#/$defs/id" },
        "minimumComparableBenchmarks": {
          "type": "integer",
          "minimum": 1
        },
        "insufficientEvidenceRule": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        }
      }
    }
  }
}
