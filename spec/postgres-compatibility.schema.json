{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/postgres-compatibility.schema.json",
  "title": "Postgres Compatibility Checkpoint",
  "description": "Checked SQLite-to-Postgres lifecycle storage semantics readback without implementing or claiming a Postgres runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "postgresCompatibilityId",
    "generatedAt",
    "compatibilityStatus",
    "runtimeScope",
    "normalChecksConnectToPostgres",
    "sqliteRuntimeRemainsDefault",
    "postgresRuntimeImplemented",
    "tableCompatibility",
    "dialectNeutralAdapterContract",
    "scenarioCompatibilityMatrix",
    "sqliteOnlyAssumptionChecks",
    "migrationBoundary",
    "executionBoundary",
    "summary",
    "warnings"
  ],
  "properties": {
    "postgresCompatibilityId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "compatibilityStatus": { "type": "string", "enum": ["sqlite_to_postgres_semantics_checked"] },
    "runtimeScope": { "type": "string", "enum": ["storage_semantics_only"] },
    "normalChecksConnectToPostgres": { "type": "boolean" },
    "sqliteRuntimeRemainsDefault": { "type": "boolean" },
    "postgresRuntimeImplemented": { "type": "boolean" },
    "tableCompatibility": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/tableCompatibility" }
    },
    "dialectNeutralAdapterContract": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/adapterContractSemantic" }
    },
    "scenarioCompatibilityMatrix": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/scenarioCompatibility" }
    },
    "sqliteOnlyAssumptionChecks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/sqliteOnlyAssumptionCheck" }
    },
    "migrationBoundary": { "$ref": "#/$defs/migrationBoundary" },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "summary": { "$ref": "#/$defs/summary" },
    "warnings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 12, "maxLength": 260 }
    }
  },
  "$defs": {
    "tableName": {
      "type": "string",
      "enum": [
        "operation_receipts",
        "operation_idempotency_keys",
        "operation_leases",
        "ope_records",
        "forecast_history_events",
        "operation_audit_records",
        "evidence_ledger_rows",
        "read_model_rows"
      ]
    },
    "scenarioName": {
      "type": "string",
      "enum": [
        "create",
        "retry-idempotent",
        "lease-conflict",
        "archive",
        "redaction",
        "method-rollback",
        "pre-calibration-bind",
        "campaign-forecast-create",
        "campaign-resolution-record",
        "campaign-score-create",
        "campaign-evidence-append",
        "pilot-evidence-append",
        "campaign-method-apply",
        "campaign-method-rollback",
        "json-state-import",
        "recovery"
      ]
    },
    "tableCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tableName",
        "sqlitePurpose",
        "sqliteWriteMode",
        "sqlitePrimaryKey",
        "sqliteTableExists",
        "postgresTablePlanned",
        "postgresTypeMappings",
        "jsonPayloadPortable",
        "contentHashPortable",
        "timestampNormalized",
        "uniqueConstraintPortable",
        "leaseExpiryPortable",
        "upsertPortable",
        "appendOnlyPortable",
        "rawCrudExposed",
        "hostedRuntimeRequired"
      ],
      "properties": {
        "tableName": { "$ref": "#/$defs/tableName" },
        "sqlitePurpose": { "type": "string", "minLength": 12, "maxLength": 220 },
        "sqliteWriteMode": {
          "type": "string",
          "enum": ["append_only", "insert_once", "upsert_expiring_lease", "projection_upsert"]
        },
        "sqlitePrimaryKey": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 2, "maxLength": 80 }
        },
        "sqliteTableExists": { "type": "boolean" },
        "postgresTablePlanned": { "type": "boolean" },
        "postgresTypeMappings": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 12, "maxLength": 180 }
        },
        "jsonPayloadPortable": { "type": "boolean" },
        "contentHashPortable": { "type": "boolean" },
        "timestampNormalized": { "type": "boolean" },
        "uniqueConstraintPortable": { "type": "boolean" },
        "leaseExpiryPortable": { "type": "boolean" },
        "upsertPortable": { "type": "boolean" },
        "appendOnlyPortable": { "type": "boolean" },
        "rawCrudExposed": { "type": "boolean" },
        "hostedRuntimeRequired": { "type": "boolean" }
      }
    },
    "adapterContractSemantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticName",
        "sqliteMapping",
        "postgresMapping",
        "portable",
        "normalChecksRequirePostgres"
      ],
      "properties": {
        "semanticName": {
          "type": "string",
          "enum": [
            "json_payloads",
            "content_hashes",
            "unique_idempotency_keys",
            "lease_acquisition",
            "lease_expiry",
            "append_only_records",
            "read_model_upserts"
          ]
        },
        "sqliteMapping": { "type": "string", "minLength": 8, "maxLength": 180 },
        "postgresMapping": { "type": "string", "minLength": 8, "maxLength": 180 },
        "portable": { "type": "boolean" },
        "normalChecksRequirePostgres": { "type": "boolean" }
      }
    },
    "scenarioCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioName",
        "operationName",
        "sqliteScenarioExists",
        "sqliteExecutionStatus",
        "expectedPostgresBehavior",
        "plannedWriteTables",
        "postgresCompatible",
        "sameOperationSemantics",
        "sameIdempotencySemantics",
        "sameLeaseSemantics",
        "sameAppendOnlySemantics",
        "sameReadModelSemantics",
        "migrationBoundary",
        "normalChecksConnectToPostgres",
        "hostedRuntimeClaimAllowed"
      ],
      "properties": {
        "scenarioName": { "$ref": "#/$defs/scenarioName" },
        "operationName": { "type": "string", "minLength": 5, "maxLength": 120 },
        "sqliteScenarioExists": { "type": "boolean" },
        "sqliteExecutionStatus": { "type": "string", "minLength": 5, "maxLength": 80 },
        "expectedPostgresBehavior": {
          "type": "string",
          "enum": [
            "commit_same_lifecycle_writes",
            "return_existing_receipt",
            "blocked_lease_conflict",
            "failed_preflight_guard"
          ]
        },
        "plannedWriteTables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/tableName" }
        },
        "postgresCompatible": { "type": "boolean" },
        "sameOperationSemantics": { "type": "boolean" },
        "sameIdempotencySemantics": { "type": "boolean" },
        "sameLeaseSemantics": { "type": "boolean" },
        "sameAppendOnlySemantics": { "type": "boolean" },
        "sameReadModelSemantics": { "type": "boolean" },
        "migrationBoundary": {
          "type": "string",
          "enum": ["not_migration", "explicit_receipt_backed_import"]
        },
        "normalChecksConnectToPostgres": { "type": "boolean" },
        "hostedRuntimeClaimAllowed": { "type": "boolean" }
      }
    },
    "sqliteOnlyAssumptionCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guardName",
        "guardStatus",
        "sqliteOnlyAssumptionDetected",
        "blocksPostgresClaimIfFailed",
        "checkedBy",
        "notes"
      ],
      "properties": {
        "guardName": {
          "type": "string",
          "enum": [
            "rowid_dependence",
            "loose_typing_dependence",
            "nonportable_upsert_behavior",
            "missing_timestamp_normalization",
            "sqlite_only_json_query_behavior"
          ]
        },
        "guardStatus": { "type": "string", "enum": ["checked"] },
        "sqliteOnlyAssumptionDetected": { "type": "boolean" },
        "blocksPostgresClaimIfFailed": { "type": "boolean" },
        "checkedBy": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 8, "maxLength": 140 }
        },
        "notes": { "type": "string", "minLength": 20, "maxLength": 260 }
      }
    },
    "migrationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automaticMigrationAllowed",
        "explicitOperationRequired",
        "migrationOperationName",
        "migrationReceiptRequired",
        "normalChecksRunMigrations",
        "historicalForecastRewriteAllowed",
        "contentHashesPreserved",
        "sourceRecordHashesPreserved"
      ],
      "properties": {
        "automaticMigrationAllowed": { "type": "boolean" },
        "explicitOperationRequired": { "type": "boolean" },
        "migrationOperationName": { "type": "string", "enum": ["state.import_json"] },
        "migrationReceiptRequired": { "type": "boolean" },
        "normalChecksRunMigrations": { "type": "boolean" },
        "historicalForecastRewriteAllowed": { "type": "boolean" },
        "contentHashesPreserved": { "type": "boolean" },
        "sourceRecordHashesPreserved": { "type": "boolean" }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postgresConnectionOpened",
        "postgresRuntimeImplemented",
        "hostedStorageClaimAllowed",
        "productionDatabaseOperationAllowed",
        "normalChecksRequireDatabase",
        "rawSqlExposedToAgents",
        "schemaMigrationExecuted",
        "credentialValuesStored"
      ],
      "properties": {
        "postgresConnectionOpened": { "type": "boolean" },
        "postgresRuntimeImplemented": { "type": "boolean" },
        "hostedStorageClaimAllowed": { "type": "boolean" },
        "productionDatabaseOperationAllowed": { "type": "boolean" },
        "normalChecksRequireDatabase": { "type": "boolean" },
        "rawSqlExposedToAgents": { "type": "boolean" },
        "schemaMigrationExecuted": { "type": "boolean" },
        "credentialValuesStored": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tableCount",
        "scenarioCount",
        "sqliteOnlyGuardCount",
        "postgresRuntimeImplemented",
        "normalChecksConnectToPostgres"
      ],
      "properties": {
        "tableCount": { "type": "integer", "minimum": 8, "maximum": 8 },
        "scenarioCount": { "type": "integer", "minimum": 16, "maximum": 16 },
        "sqliteOnlyGuardCount": { "type": "integer", "minimum": 5, "maximum": 5 },
        "postgresRuntimeImplemented": { "type": "boolean" },
        "normalChecksConnectToPostgres": { "type": "boolean" }
      }
    }
  }
}
