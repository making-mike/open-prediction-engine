{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/lifecycle-operation.schema.json",
  "title": "Lifecycle Operation Store",
  "description": "Database-backed lifecycle operation store plan for multi-agent OPE execution without mutable forecast CRUD.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lifecycleOperationStoreId",
    "generatedAt",
    "storeStatus",
    "designScope",
    "storageBackends",
    "sqliteSchemaPlan",
    "operationCatalog",
    "immutableRecordStore",
    "idempotencyModel",
    "leaseModel",
    "readModels",
    "mutationSemantics",
    "migrationPlan",
    "jsonCompatibilityAdapter",
    "writeLocalOperationCoverage",
    "fileDatabaseCompatibilityChecks",
    "agentPreflightSurface",
    "runtimeScenarios",
    "executionBoundary",
    "summary",
    "warnings"
  ],
  "properties": {
    "lifecycleOperationStoreId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "storeStatus": {
      "type": "string",
      "enum": ["local_sqlite_runtime_checked"]
    },
    "designScope": {
      "type": "string",
      "enum": ["database_backed_lifecycle_operations"]
    },
    "storageBackends": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/storageBackend" }
    },
    "sqliteSchemaPlan": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/sqliteTablePlan" }
    },
    "operationCatalog": {
      "type": "array",
      "minItems": 10,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/operationSpec" }
    },
    "immutableRecordStore": {
      "type": "array",
      "minItems": 8,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/recordClass" }
    },
    "idempotencyModel": { "$ref": "#/$defs/idempotencyModel" },
    "leaseModel": { "$ref": "#/$defs/leaseModel" },
    "readModels": {
      "type": "array",
      "minItems": 8,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/readModel" }
    },
    "mutationSemantics": { "$ref": "#/$defs/mutationSemantics" },
    "migrationPlan": { "$ref": "#/$defs/migrationPlan" },
    "jsonCompatibilityAdapter": { "$ref": "#/$defs/jsonCompatibilityAdapter" },
    "writeLocalOperationCoverage": {
      "type": "array",
      "minItems": 8,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/writeLocalOperationCoverage" }
    },
    "fileDatabaseCompatibilityChecks": {
      "type": "array",
      "minItems": 7,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/fileDatabaseCompatibilityCheck" }
    },
    "agentPreflightSurface": { "$ref": "#/$defs/agentPreflightSurface" },
    "runtimeScenarios": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "$ref": "#/$defs/runtimeScenario" }
    },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "summary": { "$ref": "#/$defs/summary" },
    "warnings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 12,
        "maxLength": 220
      }
    }
  },
  "$defs": {
    "storageBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backendId",
        "backendName",
        "implementationStatus",
        "role",
        "writesRuntimeState",
        "supportsTransactions",
        "supportsLeases",
        "supportsJsonRecords",
        "hostedRuntimeRequired",
        "notes"
      ],
      "properties": {
        "backendId": { "$ref": "common.schema.json#/$defs/id" },
        "backendName": {
          "type": "string",
          "enum": ["ignored_json_compat", "local_sqlite", "postgres_design"]
        },
        "implementationStatus": {
          "type": "string",
          "enum": ["current_compatibility", "implemented_local_runtime", "planned_production_design"]
        },
        "role": {
          "type": "string",
          "minLength": 8,
          "maxLength": 160
        },
        "writesRuntimeState": { "type": "boolean" },
        "supportsTransactions": { "type": "boolean" },
        "supportsLeases": { "type": "boolean" },
        "supportsJsonRecords": { "type": "boolean" },
        "hostedRuntimeRequired": { "type": "boolean" },
        "notes": {
          "type": "string",
          "minLength": 12,
          "maxLength": 240
        }
      }
    },
    "sqliteTablePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tableName",
        "purpose",
        "primaryKey",
        "writeMode",
        "postgresCompatible",
        "storesImmutableRecords",
        "mutableProjection",
        "rawCrudExposed"
      ],
      "properties": {
        "tableName": {
          "type": "string",
          "enum": [
            "operation_receipts",
            "operation_idempotency_keys",
            "operation_leases",
            "ope_records",
            "forecast_history_events",
            "operation_audit_records",
            "evidence_ledger_rows",
            "read_model_rows"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 12,
          "maxLength": 180
        },
        "primaryKey": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        },
        "writeMode": {
          "type": "string",
          "enum": ["append_only", "insert_once", "upsert_expiring_lease", "projection_upsert"]
        },
        "postgresCompatible": { "type": "boolean" },
        "storesImmutableRecords": { "type": "boolean" },
        "mutableProjection": { "type": "boolean" },
        "rawCrudExposed": { "type": "boolean" }
      }
    },
    "operationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationName",
        "operationClass",
        "lifecyclePhase",
        "requiresPreflight",
        "requiresIdempotencyKey",
        "requiresLease",
        "writesImmutableRecords",
        "updatesReadModels",
        "deleteReplacement",
        "allowedWriteMode",
        "retrySafety",
        "claimBoundary"
      ],
      "properties": {
        "operationName": {
          "type": "string",
          "enum": [
            "campaign.create_run",
            "forecast.create",
            "forecast.recalculate",
            "question.cancel",
            "question.annul",
            "resolution.record",
            "score.create",
            "evidence.append",
            "pre_calibration.bind",
            "method.apply",
            "method.rollback",
            "state.import_json",
            "record.archive",
            "record.redact"
          ]
        },
        "operationClass": {
          "type": "string",
          "enum": ["create", "append_update", "terminal_state", "method_state", "migration", "delete_replacement"]
        },
        "lifecyclePhase": {
          "type": "string",
          "enum": ["planning", "forecasting", "recalculation", "governance", "resolution", "scoring", "evidence", "method_update", "migration", "retention"]
        },
        "requiresPreflight": { "type": "boolean" },
        "requiresIdempotencyKey": { "type": "boolean" },
        "requiresLease": { "type": "boolean" },
        "writesImmutableRecords": { "type": "boolean" },
        "updatesReadModels": { "type": "boolean" },
        "deleteReplacement": {
          "type": "string",
          "enum": ["not_delete", "archive_tombstone", "redaction_receipt"]
        },
        "allowedWriteMode": {
          "type": "string",
          "enum": ["insert_once", "append_only", "prospective_binding", "tombstone_append", "redaction_append"]
        },
        "retrySafety": {
          "type": "string",
          "enum": ["idempotent_required", "lease_and_idempotent_required"]
        },
        "claimBoundary": { "$ref": "#/$defs/claimBoundary" }
      }
    },
    "recordClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordType",
        "schemaFile",
        "storageTable",
        "mutableAfterWrite",
        "writeMode",
        "hashRequired",
        "provenanceRequired"
      ],
      "properties": {
        "recordType": {
          "type": "string",
          "enum": [
            "forecast_question",
            "evidence_packet",
            "forecast_artifact",
            "forecast_history",
            "resolution_record",
            "scoring_report",
            "calibration_summary",
            "pre_calibration_binding",
            "method_update_audit",
            "evidence_ledger_row",
            "json_state_migration_receipt",
            "operation_receipt",
            "archive_tombstone",
            "redaction_receipt"
          ]
        },
        "schemaFile": {
          "type": "string",
          "minLength": 8,
          "maxLength": 120
        },
        "storageTable": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "mutableAfterWrite": { "type": "boolean" },
        "writeMode": {
          "type": "string",
          "enum": ["insert_once", "append_only"]
        },
        "hashRequired": { "type": "boolean" },
        "provenanceRequired": { "type": "boolean" }
      }
    },
    "idempotencyModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tableName",
        "requiredForAllEffectfulOperations",
        "keyFields",
        "conflictPolicy",
        "storesOperationReceipt",
        "storesSourceRecordHashes",
        "retryBehavior"
      ],
      "properties": {
        "tableName": { "type": "string", "enum": ["operation_idempotency_keys"] },
        "requiredForAllEffectfulOperations": { "type": "boolean" },
        "keyFields": {
          "type": "array",
          "minItems": 5,
          "maxItems": 8,
          "items": {
            "type": "string",
            "enum": ["operationName", "campaignId", "runId", "forecastId", "callerId", "idempotencyKey", "sourceRecordHash"]
          }
        },
        "conflictPolicy": {
          "type": "string",
          "enum": ["return_existing_receipt_or_block_mismatch"]
        },
        "storesOperationReceipt": { "type": "boolean" },
        "storesSourceRecordHashes": { "type": "boolean" },
        "retryBehavior": {
          "type": "string",
          "enum": ["safe_repeat_returns_same_receipt"]
        }
      }
    },
    "leaseModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tableName",
        "leaseRequiredFor",
        "leaseOwnerField",
        "expiresAtRequired",
        "conflictStatus",
        "renewalPolicy",
        "releasePolicy"
      ],
      "properties": {
        "tableName": { "type": "string", "enum": ["operation_leases"] },
        "leaseRequiredFor": {
          "type": "array",
          "minItems": 5,
          "maxItems": 9,
          "items": {
            "type": "string",
            "enum": ["campaign.create_run", "forecast.create", "resolution.record", "score.create", "evidence.append", "pre_calibration.bind", "method.apply", "method.rollback", "state.import_json"]
          }
        },
        "leaseOwnerField": { "type": "string", "enum": ["agentOrWorkerId"] },
        "expiresAtRequired": { "type": "boolean" },
        "conflictStatus": { "type": "string", "enum": ["blocked_lease_conflict"] },
        "renewalPolicy": { "type": "string", "enum": ["explicit_renewal_before_expiry"] },
        "releasePolicy": { "type": "string", "enum": ["release_after_receipt_or_expiry"] }
      }
    },
    "readModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readModelName",
        "purpose",
        "sourceTables",
        "agentQuestion",
        "readOnly",
        "stalenessPolicy"
      ],
      "properties": {
        "readModelName": {
          "type": "string",
          "enum": [
            "campaign_status",
            "next_due_forecast",
            "due_resolution_jobs",
            "unresolved_forecasts",
            "append_readiness",
            "calibration_status",
            "track_record_progress",
            "failed_operations",
            "recovery_actions"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 12,
          "maxLength": 220
        },
        "sourceTables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          }
        },
        "agentQuestion": {
          "type": "string",
          "minLength": 8,
          "maxLength": 180
        },
        "readOnly": { "type": "boolean" },
        "stalenessPolicy": {
          "type": "string",
          "enum": ["transactional_projection", "rebuildable_projection"]
        }
      }
    },
    "mutationSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawCrudExposed",
        "forecastArtifactsMutable",
        "forecastHistoriesMutable",
        "updatesAppendHistory",
        "deleteAllowedAsPhysicalDefault",
        "deleteReplacementOperations",
        "prospectiveMethodBindingsOnly",
        "postOutcomeForecastRewriteAllowed"
      ],
      "properties": {
        "rawCrudExposed": { "type": "boolean" },
        "forecastArtifactsMutable": { "type": "boolean" },
        "forecastHistoriesMutable": { "type": "boolean" },
        "updatesAppendHistory": { "type": "boolean" },
        "deleteAllowedAsPhysicalDefault": { "type": "boolean" },
        "deleteReplacementOperations": {
          "type": "array",
          "minItems": 4,
          "maxItems": 6,
          "items": {
            "type": "string",
            "enum": ["question.cancel", "question.annul", "record.archive", "record.redact", "method.rollback"]
          }
        },
        "prospectiveMethodBindingsOnly": { "type": "boolean" },
        "postOutcomeForecastRewriteAllowed": { "type": "boolean" }
      }
    },
    "migrationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromState",
        "firstTarget",
        "importsIgnoredJsonState",
        "rewritesHistoricalForecasts",
        "preservesContentHashes",
        "migrationReceiptRequired",
        "normalChecksRequireDatabase"
      ],
      "properties": {
        "fromState": { "type": "string", "enum": ["ignored_json_live_state"] },
        "firstTarget": { "type": "string", "enum": ["local_sqlite"] },
        "importsIgnoredJsonState": { "type": "boolean" },
        "rewritesHistoricalForecasts": { "type": "boolean" },
        "preservesContentHashes": { "type": "boolean" },
        "migrationReceiptRequired": { "type": "boolean" },
        "normalChecksRequireDatabase": { "type": "boolean" }
      }
    },
    "jsonCompatibilityAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterName",
        "adapterStatus",
        "sourceRoot",
        "readCompatibilityAllowed",
        "writeCompatibilityAllowed",
        "normalChecksWriteLiveState",
        "automaticMigrationAllowed",
        "explicitMigrationOperationRequired",
        "migrationReceiptRequired",
        "contentHashCheckRequired",
        "sourceRecordHashRequired",
        "preservesForecastProbabilities",
        "preservesSourceProvenance",
        "rewritesHistoricalForecasts",
        "rawCrudExposed",
        "stateClasses",
        "knownLimitations"
      ],
      "properties": {
        "adapterName": {
          "type": "string",
          "enum": ["ignored_json_live_state"]
        },
        "adapterStatus": {
          "type": "string",
          "enum": ["current_compatibility_adapter"]
        },
        "sourceRoot": {
          "type": "string",
          "enum": [".ope/live/prediction-campaigns"]
        },
        "readCompatibilityAllowed": { "type": "boolean" },
        "writeCompatibilityAllowed": { "type": "boolean" },
        "normalChecksWriteLiveState": { "type": "boolean" },
        "automaticMigrationAllowed": { "type": "boolean" },
        "explicitMigrationOperationRequired": { "type": "boolean" },
        "migrationReceiptRequired": { "type": "boolean" },
        "contentHashCheckRequired": { "type": "boolean" },
        "sourceRecordHashRequired": { "type": "boolean" },
        "preservesForecastProbabilities": { "type": "boolean" },
        "preservesSourceProvenance": { "type": "boolean" },
        "rewritesHistoricalForecasts": { "type": "boolean" },
        "rawCrudExposed": { "type": "boolean" },
        "stateClasses": {
          "type": "array",
          "minItems": 5,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/jsonCompatibilityStateClass" }
        },
        "knownLimitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 12,
            "maxLength": 180
          }
        }
      }
    },
    "jsonCompatibilityStateClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stateClass",
        "sourcePathPattern",
        "migrationTargetTable",
        "contentHashPreserved",
        "migrationReceiptRequired",
        "rawCrudExposed"
      ],
      "properties": {
        "stateClass": {
          "type": "string",
          "enum": [
            "forecast_lifecycle_records",
            "campaign_state",
            "run_state",
            "evidence_ledger",
            "method_binding",
            "operation_audit"
          ]
        },
        "sourcePathPattern": {
          "type": "string",
          "minLength": 8,
          "maxLength": 140
        },
        "migrationTargetTable": {
          "type": "string",
          "enum": ["ope_records", "forecast_history_events", "operation_audit_records", "evidence_ledger_rows", "read_model_rows"]
        },
        "contentHashPreserved": { "type": "boolean" },
        "migrationReceiptRequired": { "type": "boolean" },
        "rawCrudExposed": { "type": "boolean" }
      }
    },
    "agentPreflightSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflightRequired",
        "plannedWritesListed",
        "blockingGuardsListed",
        "idempotencyKeyEchoed",
        "leasePlanListed",
        "operationReceiptReturned",
        "safeRetryAdviceReturned",
        "claimBoundaryReturned"
      ],
      "properties": {
        "preflightRequired": { "type": "boolean" },
        "plannedWritesListed": { "type": "boolean" },
        "blockingGuardsListed": { "type": "boolean" },
        "idempotencyKeyEchoed": { "type": "boolean" },
        "leasePlanListed": { "type": "boolean" },
        "operationReceiptReturned": { "type": "boolean" },
        "safeRetryAdviceReturned": { "type": "boolean" },
        "claimBoundaryReturned": { "type": "boolean" }
      }
    },
    "writeLocalOperationCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverageId",
        "commandPath",
        "lifecycleOperations",
        "scenarioNames",
        "requiredOperationReceiptCount",
        "requiredReadModels",
        "allReceiptsChecked",
        "allReadModelsChecked",
        "idempotencyRequired",
        "leaseRequired",
        "rawCrudExposed",
        "normalChecksWriteLiveState",
        "compatibilityJsonWriteAllowed",
        "notes"
      ],
      "properties": {
        "coverageId": { "$ref": "common.schema.json#/$defs/id" },
        "commandPath": {
          "type": "string",
          "enum": [
            "prediction-campaign start --write-local",
            "prediction-campaign start --pre-calibrate --write-local",
            "prediction-campaign forecast-write --write-local",
            "prediction-campaign resolve --execute-resolvers --write-local",
            "prediction-campaign append --write-local",
            "prediction-campaign pre-calibration --write-local",
            "prediction-campaign apply-method-update --write-local",
            "prediction-campaign rollback-method-update --write-local"
          ]
        },
        "lifecycleOperations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": [
              "forecast.create",
              "resolution.record",
              "score.create",
              "evidence.append",
              "pre_calibration.bind",
              "method.apply",
              "method.rollback"
            ]
          }
        },
        "scenarioNames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": [
              "pre-calibration-bind",
              "campaign-forecast-create",
              "campaign-resolution-record",
              "campaign-score-create",
              "campaign-evidence-append",
              "campaign-method-apply",
              "campaign-method-rollback"
            ]
          }
        },
        "requiredOperationReceiptCount": { "type": "integer", "minimum": 1, "maximum": 3 },
        "requiredReadModels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "enum": [
              "campaign_status",
              "next_due_forecast",
              "due_resolution_jobs",
              "unresolved_forecasts",
              "append_readiness",
              "calibration_status",
              "track_record_progress"
            ]
          }
        },
        "allReceiptsChecked": { "type": "boolean" },
        "allReadModelsChecked": { "type": "boolean" },
        "idempotencyRequired": { "type": "boolean" },
        "leaseRequired": { "type": "boolean" },
        "rawCrudExposed": { "type": "boolean" },
        "normalChecksWriteLiveState": { "type": "boolean" },
        "compatibilityJsonWriteAllowed": { "type": "boolean" },
        "notes": {
          "type": "string",
          "minLength": 12,
          "maxLength": 220
        }
      }
    },
    "runtimeScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "scenarioName",
        "operationName",
        "sqliteRuntimeExercised",
        "setupOperationCount",
        "preflightStatus",
        "executionStatus",
        "idempotencyStatus",
        "leaseStatus",
        "operationReceiptId",
        "plannedWriteCount",
        "operationReceiptsWritten",
        "immutableRecordsInserted",
        "auditRecordsInserted",
        "duplicateRecordsCreated",
        "physicalDeletes",
        "historyRewriteCount",
        "rawCrudExposed",
        "forecastArtifactMutable",
        "payloadHashBindings",
        "migrationImportSummary",
        "readModelEffects",
        "recoveryPath",
        "preflight",
        "message"
      ],
      "properties": {
        "scenarioId": { "$ref": "common.schema.json#/$defs/id" },
        "scenarioName": {
          "type": "string",
          "enum": [
            "create",
            "retry-idempotent",
            "lease-conflict",
            "archive",
            "redaction",
            "method-rollback",
            "pre-calibration-bind",
            "campaign-forecast-create",
            "campaign-resolution-record",
            "campaign-score-create",
            "campaign-evidence-append",
            "campaign-method-apply",
            "campaign-method-rollback",
            "json-state-import",
            "recovery"
          ]
        },
        "operationName": {
          "type": "string",
          "enum": [
            "campaign.create_run",
            "forecast.create",
            "forecast.recalculate",
            "question.cancel",
            "question.annul",
            "resolution.record",
            "score.create",
            "evidence.append",
            "pre_calibration.bind",
            "method.apply",
            "method.rollback",
            "state.import_json",
            "record.archive",
            "record.redact"
          ]
        },
        "sqliteRuntimeExercised": { "type": "boolean" },
        "setupOperationCount": { "type": "integer", "minimum": 0, "maximum": 4 },
        "preflightStatus": {
          "type": "string",
          "enum": [
            "preflight_pass",
            "idempotent_replay_available",
            "blocked_idempotency_mismatch",
            "blocked_lease_conflict",
            "failed_preflight_guard"
          ]
        },
        "executionStatus": {
          "type": "string",
          "enum": [
            "committed",
            "idempotent_replay",
            "blocked_idempotency_mismatch",
            "blocked_lease_conflict",
            "failed_preflight_guard"
          ]
        },
        "idempotencyStatus": {
          "type": "string",
          "enum": ["new_key_available", "return_existing_receipt", "block_mismatched_retry"]
        },
        "leaseStatus": {
          "type": "string",
          "enum": ["not_required", "available", "blocked_lease_conflict"]
        },
        "operationReceiptId": { "$ref": "common.schema.json#/$defs/id" },
        "plannedWriteCount": { "type": "integer", "minimum": 1, "maximum": 8 },
        "operationReceiptsWritten": { "type": "integer", "minimum": 0, "maximum": 2 },
        "immutableRecordsInserted": { "type": "integer", "minimum": 0, "maximum": 8 },
        "auditRecordsInserted": { "type": "integer", "minimum": 0, "maximum": 4 },
        "duplicateRecordsCreated": { "type": "integer", "minimum": 0, "maximum": 0 },
        "physicalDeletes": { "type": "integer", "minimum": 0, "maximum": 0 },
        "historyRewriteCount": { "type": "integer", "minimum": 0, "maximum": 0 },
        "rawCrudExposed": { "type": "boolean" },
        "forecastArtifactMutable": { "type": "boolean" },
        "payloadHashBindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/payloadHashBinding" }
        },
        "migrationImportSummary": {
          "anyOf": [
            { "$ref": "#/$defs/migrationImportSummary" },
            { "type": "null" }
          ]
        },
        "readModelEffects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "type": "string",
            "enum": [
              "campaign_status",
              "next_due_forecast",
              "due_resolution_jobs",
              "unresolved_forecasts",
              "append_readiness",
              "calibration_status",
              "track_record_progress",
              "failed_operations",
              "recovery_actions"
            ]
          }
        },
        "recoveryPath": {
          "type": "string",
          "minLength": 8,
          "maxLength": 160
        },
        "preflight": { "$ref": "#/$defs/runtimePreflight" },
        "message": {
          "type": "string",
          "minLength": 8,
          "maxLength": 180
        }
      }
    },
    "fileDatabaseCompatibilityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatibilityCheckId",
        "recordClass",
        "commandPath",
        "scenarioName",
        "lifecycleOperation",
        "fileModeRepeatStatus",
        "fileModeDuplicatePrevented",
        "databaseFirstExecutionStatus",
        "databaseReplayExecutionStatus",
        "databaseReplayIdempotencyStatus",
        "databaseReplayOperationReceiptsWritten",
        "databaseDuplicateRecordsCreated",
        "contentHashComparisonRequired",
        "historyRewriteCount",
        "physicalDeletes",
        "rawCrudExposed",
        "compatible"
      ],
      "properties": {
        "compatibilityCheckId": { "$ref": "common.schema.json#/$defs/id" },
        "recordClass": {
          "type": "string",
          "enum": [
            "forecast_lifecycle_records",
            "resolution_records",
            "scoring_reports",
            "evidence_ledger_rows",
            "pre_calibration_method_binding",
            "method_apply_binding",
            "method_rollback_binding"
          ]
        },
        "commandPath": {
          "type": "string",
          "enum": [
            "prediction-campaign forecast-write --write-local",
            "prediction-campaign resolve --execute-resolvers --write-local",
            "prediction-campaign append --write-local",
            "prediction-campaign pre-calibration --write-local",
            "prediction-campaign apply-method-update --write-local",
            "prediction-campaign rollback-method-update --write-local"
          ]
        },
        "scenarioName": {
          "type": "string",
          "enum": [
            "pre-calibration-bind",
            "campaign-forecast-create",
            "campaign-resolution-record",
            "campaign-score-create",
            "campaign-evidence-append",
            "campaign-method-apply",
            "campaign-method-rollback"
          ]
        },
        "lifecycleOperation": {
          "type": "string",
          "enum": [
            "forecast.create",
            "resolution.record",
            "score.create",
            "evidence.append",
            "pre_calibration.bind",
            "method.apply",
            "method.rollback"
          ]
        },
        "fileModeRepeatStatus": {
          "type": "string",
          "enum": [
            "local_write_already_present",
            "local_resolution_scored_already_present",
            "local_append_already_present",
            "local_pre_calibration_already_present",
            "local_apply_already_present",
            "local_rollback_already_present"
          ]
        },
        "fileModeDuplicatePrevented": { "type": "boolean" },
        "databaseFirstExecutionStatus": { "type": "string", "enum": ["committed"] },
        "databaseReplayExecutionStatus": { "type": "string", "enum": ["idempotent_replay"] },
        "databaseReplayIdempotencyStatus": { "type": "string", "enum": ["return_existing_receipt"] },
        "databaseReplayOperationReceiptsWritten": { "type": "integer", "minimum": 0, "maximum": 0 },
        "databaseDuplicateRecordsCreated": { "type": "integer", "minimum": 0, "maximum": 0 },
        "contentHashComparisonRequired": { "type": "boolean" },
        "historyRewriteCount": { "type": "integer", "minimum": 0, "maximum": 0 },
        "physicalDeletes": { "type": "integer", "minimum": 0, "maximum": 0 },
        "rawCrudExposed": { "type": "boolean" },
        "compatible": { "type": "boolean" }
      }
    },
    "runtimePreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plannedWrites", "blockingGuards", "idempotencyKey", "leasePlan", "claimBoundary"],
      "properties": {
        "plannedWrites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/runtimePlannedWrite" }
        },
        "blockingGuards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/runtimeBlockingGuard" }
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 160
        },
        "leasePlan": { "$ref": "#/$defs/runtimeLeasePlan" },
        "claimBoundary": { "$ref": "#/$defs/claimBoundary" }
      }
    },
    "runtimePlannedWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tableName", "recordType", "recordId", "writeMode"],
      "properties": {
        "tableName": {
          "type": "string",
          "enum": ["operation_receipts", "ope_records", "forecast_history_events", "operation_audit_records", "evidence_ledger_rows", "read_model_rows"]
        },
        "recordType": {
          "type": "string",
          "enum": [
            "forecast_artifact",
            "forecast_question",
            "forecast_history",
            "evidence_packet",
            "resolution_record",
            "scoring_report",
            "evidence_ledger_row",
            "pre_calibration_binding",
            "method_update_audit",
            "method_binding_state",
            "json_state_migration_receipt",
            "run_state_projection",
            "campaign_state_projection",
            "operation_receipt",
            "archive_tombstone",
            "redaction_receipt"
          ]
        },
        "recordId": { "$ref": "common.schema.json#/$defs/id" },
        "writeMode": {
          "type": "string",
          "enum": ["append_only", "insert_once", "prospective_binding", "projection_upsert", "tombstone_append", "redaction_append"]
        }
      }
    },
    "migrationImportSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRoot",
        "stateClassCount",
        "sourceFileCount",
        "contentHashesPreserved",
        "forecastProbabilitiesPreserved",
        "sourceProvenancePreserved",
        "historicalForecastRewriteCount",
        "methodBindingsPreserved",
        "migrationReceiptRequired",
        "automaticMigrationAllowed"
      ],
      "properties": {
        "sourceRoot": { "type": "string", "enum": [".ope/live/prediction-campaigns"] },
        "stateClassCount": { "type": "integer", "minimum": 1, "maximum": 8 },
        "sourceFileCount": { "type": "integer", "minimum": 1, "maximum": 12 },
        "contentHashesPreserved": { "type": "boolean" },
        "forecastProbabilitiesPreserved": { "type": "boolean" },
        "sourceProvenancePreserved": { "type": "boolean" },
        "historicalForecastRewriteCount": { "type": "integer", "minimum": 0, "maximum": 0 },
        "methodBindingsPreserved": { "type": "boolean" },
        "migrationReceiptRequired": { "type": "boolean" },
        "automaticMigrationAllowed": { "type": "boolean" }
      }
    },
    "payloadHashBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "recordId", "sourceContentHash", "sqliteContentHash", "matchesSourceHash"],
      "properties": {
        "recordType": {
          "type": "string",
          "enum": [
            "forecast_question",
            "evidence_packet",
            "forecast_artifact",
            "forecast_history",
            "resolution_record",
            "scoring_report",
            "evidence_ledger_row",
            "pre_calibration_binding",
            "method_update_audit",
            "method_binding_state",
            "json_state_migration_receipt",
            "run_state_projection",
            "campaign_state_projection",
            "operation_receipt",
            "archive_tombstone",
            "redaction_receipt"
          ]
        },
        "recordId": { "$ref": "common.schema.json#/$defs/id" },
        "sourceContentHash": {
          "type": "string",
          "minLength": 16,
          "maxLength": 96
        },
        "sqliteContentHash": {
          "type": "string",
          "minLength": 16,
          "maxLength": 96
        },
        "matchesSourceHash": { "type": "boolean" }
      }
    },
    "runtimeBlockingGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guardId", "guardStatus", "blocksOperation", "message"],
      "properties": {
        "guardId": { "$ref": "common.schema.json#/$defs/id" },
        "guardStatus": {
          "type": "string",
          "enum": ["pass", "idempotent_repeat", "fail"]
        },
        "blocksOperation": { "type": "boolean" },
        "message": {
          "type": "string",
          "minLength": 8,
          "maxLength": 220
        }
      }
    },
    "runtimeLeasePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresLease", "leaseKey", "ownerId", "expiresAt"],
      "properties": {
        "requiresLease": { "type": "boolean" },
        "leaseKey": {
          "type": "string",
          "maxLength": 160
        },
        "ownerId": {
          "type": "string",
          "maxLength": 80
        },
        "expiresAt": {
          "type": "string",
          "maxLength": 32
        }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readbackExecutesDatabaseWrites",
        "sqliteRuntimeImplemented",
        "sqliteScenarioUsesEphemeralDatabase",
        "postgresRuntimeImplemented",
        "hostedRuntimeImplemented",
        "networkApiImplemented",
        "osSchedulerInstalled",
        "rawCrudExposedToAgents",
        "normalChecksRequireDatabase",
        "storesCredentials",
        "fetchesLiveData",
        "createsForecastArtifacts",
        "createsResolutionArtifacts",
        "createsScoringRecords",
        "qualityClaimAllowed"
      ],
      "properties": {
        "readbackExecutesDatabaseWrites": { "type": "boolean" },
        "sqliteRuntimeImplemented": { "type": "boolean" },
        "sqliteScenarioUsesEphemeralDatabase": { "type": "boolean" },
        "postgresRuntimeImplemented": { "type": "boolean" },
        "hostedRuntimeImplemented": { "type": "boolean" },
        "networkApiImplemented": { "type": "boolean" },
        "osSchedulerInstalled": { "type": "boolean" },
        "rawCrudExposedToAgents": { "type": "boolean" },
        "normalChecksRequireDatabase": { "type": "boolean" },
        "storesCredentials": { "type": "boolean" },
        "fetchesLiveData": { "type": "boolean" },
        "createsForecastArtifacts": { "type": "boolean" },
        "createsResolutionArtifacts": { "type": "boolean" },
        "createsScoringRecords": { "type": "boolean" },
        "qualityClaimAllowed": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "databaseBackendPlanned",
        "databaseBackendImplemented",
        "firstBackend",
        "productionDesignBackend",
        "operationCount",
        "readModelCount",
        "immutableRecordClassCount",
        "sqliteTableCount",
        "runtimeScenarioCount",
        "writeLocalOperationCoverageCount",
        "allWriteLocalPathsReceiptBacked",
        "allWriteLocalPathsReadModelBacked",
        "fileDatabaseCompatibilityCheckCount",
        "fileDatabaseCompatibilityChecked",
        "deleteReplacedByLifecycleOperations",
        "agentImplementationReady",
        "sqliteRuntimeChecked",
        "runtimeImplementationStatus"
      ],
      "properties": {
        "databaseBackendPlanned": { "type": "boolean" },
        "databaseBackendImplemented": { "type": "boolean" },
        "firstBackend": { "type": "string", "enum": ["local_sqlite"] },
        "productionDesignBackend": { "type": "string", "enum": ["postgres_design"] },
        "operationCount": { "type": "integer", "minimum": 10 },
        "readModelCount": { "type": "integer", "minimum": 8 },
        "immutableRecordClassCount": { "type": "integer", "minimum": 8 },
        "sqliteTableCount": { "type": "integer", "minimum": 8 },
        "runtimeScenarioCount": { "type": "integer", "minimum": 7 },
        "writeLocalOperationCoverageCount": { "type": "integer", "minimum": 8 },
        "allWriteLocalPathsReceiptBacked": { "type": "boolean" },
        "allWriteLocalPathsReadModelBacked": { "type": "boolean" },
        "fileDatabaseCompatibilityCheckCount": { "type": "integer", "minimum": 7 },
        "fileDatabaseCompatibilityChecked": { "type": "boolean" },
        "deleteReplacedByLifecycleOperations": { "type": "boolean" },
        "agentImplementationReady": { "type": "boolean" },
        "sqliteRuntimeChecked": { "type": "boolean" },
        "runtimeImplementationStatus": {
          "type": "string",
          "enum": ["local_sqlite_runtime_checked"]
        }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createsQualityClaim",
        "allowsPostOutcomeRewrite",
        "allowsSilentDelete",
        "allowsRawCrud"
      ],
      "properties": {
        "createsQualityClaim": { "type": "boolean" },
        "allowsPostOutcomeRewrite": { "type": "boolean" },
        "allowsSilentDelete": { "type": "boolean" },
        "allowsRawCrud": { "type": "boolean" }
      }
    }
  }
}
