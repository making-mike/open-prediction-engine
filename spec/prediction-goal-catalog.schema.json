{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/prediction-goal-catalog.schema.json",
  "title": "Prediction Goal Catalog",
  "description": "Checked domain-agnostic catalog of host prediction goals for setup-engine examples.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "predictionGoalCatalogId",
    "generatedAt",
    "catalogStatus",
    "setupEngineBinding",
    "classificationVocabulary",
    "goalExamples",
    "executionBoundary",
    "summary",
    "warnings",
    "qualityClaimAllowed",
    "createsForecastArtifacts",
    "hostedRuntimeRequired"
  ],
  "properties": {
    "predictionGoalCatalogId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "catalogStatus": { "type": "string", "enum": ["checked_domain_agnostic_goal_catalog"] },
    "setupEngineBinding": { "$ref": "#/$defs/setupEngineBinding" },
    "classificationVocabulary": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/classification" }
    },
    "goalExamples": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/goalExample" }
    },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "summary": { "$ref": "#/$defs/summary" },
    "warnings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 12, "maxLength": 260 }
    },
    "qualityClaimAllowed": { "type": "boolean" },
    "createsForecastArtifacts": { "type": "boolean" },
    "hostedRuntimeRequired": { "type": "boolean" }
  },
  "$defs": {
    "setupEngineBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setupEngineId", "setupEngineCommand", "examplesViewCommand", "relationship"],
      "properties": {
        "setupEngineId": { "$ref": "common.schema.json#/$defs/id" },
        "setupEngineCommand": { "type": "string", "minLength": 8, "maxLength": 220 },
        "examplesViewCommand": { "type": "string", "minLength": 8, "maxLength": 220 },
        "relationship": { "type": "string", "minLength": 20, "maxLength": 260 }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "meaning", "firstSafeAction"],
      "properties": {
        "classification": { "type": "string", "enum": ["forecastable", "needs_clarification", "blocked", "rejected"] },
        "meaning": { "type": "string", "minLength": 20, "maxLength": 260 },
        "firstSafeAction": { "type": "string", "minLength": 12, "maxLength": 220 }
      }
    },
    "goalExample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goalKey",
        "goalTitle",
        "hostGoal",
        "classification",
        "reasonCodes",
        "requiredSourceRoles",
        "baselineCandidate",
        "resolutionSource",
        "forecastCardFields",
        "firstSafeHostAction",
        "blockedReason",
        "setupEnginePreferredView",
        "qualityClaimAllowed",
        "createsForecastArtifacts",
        "hostedRuntimeRequired"
      ],
      "properties": {
        "goalKey": {
          "type": "string",
          "enum": [
            "delivery_delay_risk",
            "stockout_risk",
            "sla_breach_risk",
            "demand_risk",
            "churn_risk",
            "seaport_berth_availability",
            "weather_sensitive_operations",
            "public_transit_disruption_risk"
          ]
        },
        "goalTitle": { "type": "string", "minLength": 8, "maxLength": 140 },
        "hostGoal": { "type": "string", "minLength": 20, "maxLength": 260 },
        "classification": { "type": "string", "enum": ["forecastable", "needs_clarification", "blocked", "rejected"] },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "requiredSourceRoles": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "baselineCandidate": { "$ref": "#/$defs/baselineCandidate" },
        "resolutionSource": { "$ref": "#/$defs/resolutionSource" },
        "forecastCardFields": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "firstSafeHostAction": { "type": "string", "minLength": 0, "maxLength": 260 },
        "blockedReason": { "type": "string", "minLength": 0, "maxLength": 260 },
        "setupEnginePreferredView": { "type": "string", "enum": ["contracts", "sources", "baseline", "claim-boundary", "examples"] },
        "qualityClaimAllowed": { "type": "boolean" },
        "createsForecastArtifacts": { "type": "boolean" },
        "hostedRuntimeRequired": { "type": "boolean" }
      }
    },
    "baselineCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methodId", "methodClass", "executionAllowed", "qualityClaimAllowed", "notes"],
      "properties": {
        "methodId": { "type": "string", "minLength": 3, "maxLength": 80 },
        "methodClass": { "type": "string", "enum": ["historical_baseline", "blocked"] },
        "executionAllowed": { "type": "boolean" },
        "qualityClaimAllowed": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 12, "maxLength": 220 }
      }
    },
    "resolutionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRole", "resolutionRule", "availableBeforeForecast"],
      "properties": {
        "sourceRole": { "type": "string", "enum": ["resolution_outcome"] },
        "resolutionRule": { "type": "string", "minLength": 12, "maxLength": 260 },
        "availableBeforeForecast": { "type": "boolean" }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createsForecastArtifacts",
        "hostedRuntimeRequired",
        "qualityClaimAllowed",
        "calibrationClaimAllowed",
        "fetchesLiveData",
        "storesCredentialValues",
        "acceptsRawPrivateRows",
        "acceptsRawSql"
      ],
      "properties": {
        "createsForecastArtifacts": { "type": "boolean" },
        "hostedRuntimeRequired": { "type": "boolean" },
        "qualityClaimAllowed": { "type": "boolean" },
        "calibrationClaimAllowed": { "type": "boolean" },
        "fetchesLiveData": { "type": "boolean" },
        "storesCredentialValues": { "type": "boolean" },
        "acceptsRawPrivateRows": { "type": "boolean" },
        "acceptsRawSql": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goalExampleCount",
        "forecastableCount",
        "needsClarificationCount",
        "blockedCount",
        "rejectedCount",
        "classificationCount",
        "helsinkiDefaultNarrative",
        "qualityClaimAllowed"
      ],
      "properties": {
        "goalExampleCount": { "type": "integer", "minimum": 8, "maximum": 8 },
        "forecastableCount": { "type": "integer", "minimum": 0, "maximum": 8 },
        "needsClarificationCount": { "type": "integer", "minimum": 0, "maximum": 8 },
        "blockedCount": { "type": "integer", "minimum": 0, "maximum": 8 },
        "rejectedCount": { "type": "integer", "minimum": 0, "maximum": 8 },
        "classificationCount": { "type": "integer", "minimum": 4, "maximum": 4 },
        "helsinkiDefaultNarrative": { "type": "boolean" },
        "qualityClaimAllowed": { "type": "boolean" }
      }
    }
  }
}
