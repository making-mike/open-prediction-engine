{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/setup-benchmark-gate.schema.json",
  "title": "Setup Benchmark Gate",
  "description": "Setup-specific benchmark gate for allowing a non-baseline method to execute without granting broader quality claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "setupBenchmarkGateId",
    "generatedAt",
    "case",
    "domainSetupId",
    "domain",
    "sourceIntakeReportId",
    "sourceManifestId",
    "fieldMappingId",
    "methodClass",
    "gateStatus",
    "baselineMethodId",
    "candidateMethodId",
    "benchmarkEvidence",
    "sourceEligibility",
    "antiLeakageControls",
    "metricThresholds",
    "decision",
    "reasonCodes",
    "warnings"
  ],
  "properties": {
    "setupBenchmarkGateId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "case": {
      "type": "string",
      "enum": [
        "accepted",
        "accepted_partial",
        "needs_confirmation",
        "rejected",
        "unconfirmed_builder_draft",
        "confirmed_builder_draft",
        "insufficient_confirmed_builder_draft"
      ]
    },
    "domainSetupId": { "$ref": "common.schema.json#/$defs/id" },
    "domain": { "$ref": "common.schema.json#/$defs/domain" },
    "sourceIntakeReportId": { "$ref": "common.schema.json#/$defs/id" },
    "sourceIntakeHandoffId": { "$ref": "#/$defs/nullableId" },
    "sourceManifestId": { "$ref": "common.schema.json#/$defs/id" },
    "fieldMappingId": { "$ref": "common.schema.json#/$defs/id" },
    "methodClass": {
      "type": "string",
      "enum": ["deterministic_statistical"]
    },
    "gateStatus": {
      "type": "string",
      "enum": ["approved_provisional", "blocked"]
    },
    "baselineMethodId": { "$ref": "#/$defs/nullableId" },
    "candidateMethodId": { "$ref": "#/$defs/nullableId" },
    "benchmarkEvidence": { "$ref": "#/$defs/benchmarkEvidence" },
    "sourceEligibility": { "$ref": "#/$defs/sourceEligibility" },
    "antiLeakageControls": { "$ref": "#/$defs/antiLeakageControls" },
    "metricThresholds": { "$ref": "#/$defs/metricThresholds" },
    "decision": { "$ref": "#/$defs/decision" },
    "reasonCodes": { "$ref": "#/$defs/reasonCodes" },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 240
      }
    }
  },
  "$defs": {
    "nullableId": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/id" },
        { "type": "null" }
      ]
    },
    "nullableTimestampRange": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["startsAt", "endsAt"],
          "properties": {
            "startsAt": { "$ref": "common.schema.json#/$defs/timestamp" },
            "endsAt": { "$ref": "common.schema.json#/$defs/timestamp" }
          }
        },
        { "type": "null" }
      ]
    },
    "nullableNumber": {
      "oneOf": [
        { "type": "number" },
        { "type": "null" }
      ]
    },
    "benchmarkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodRegistryId",
        "baselineBenchmarkRunId",
        "candidateBenchmarkRunId",
        "sourcePolicyId",
        "retrievalWindow",
        "questionSetSize",
        "qualityClaimStatus"
      ],
      "properties": {
        "methodRegistryId": { "$ref": "#/$defs/nullableId" },
        "baselineBenchmarkRunId": { "$ref": "#/$defs/nullableId" },
        "candidateBenchmarkRunId": { "$ref": "#/$defs/nullableId" },
        "sourcePolicyId": { "$ref": "#/$defs/nullableId" },
        "retrievalWindow": { "$ref": "#/$defs/nullableTimestampRange" },
        "questionSetSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "qualityClaimStatus": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        }
      }
    },
    "sourceEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "requiredSourceRoles",
        "usableSourceRoles",
        "missingSourceRoles",
        "mappingConfirmationRequired"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["eligible", "needs_confirmation", "rejected"]
        },
        "requiredSourceRoles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          }
        },
        "usableSourceRoles": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          }
        },
        "missingSourceRoles": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          }
        },
        "mappingConfirmationRequired": { "type": "boolean" }
      }
    },
    "antiLeakageControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sameQuestionSet",
        "sameSourcePolicy",
        "sameRetrievalWindow",
        "leakageValidated",
        "sourceTimestampsRecorded",
        "resolutionSourcesExcluded",
        "trainingCutoffBeforeRetrievalEnd"
      ],
      "properties": {
        "sameQuestionSet": { "type": "boolean" },
        "sameSourcePolicy": { "type": "boolean" },
        "sameRetrievalWindow": { "type": "boolean" },
        "leakageValidated": { "type": "boolean" },
        "sourceTimestampsRecorded": { "type": "boolean" },
        "resolutionSourcesExcluded": { "type": "boolean" },
        "trainingCutoffBeforeRetrievalEnd": { "type": "boolean" }
      }
    },
    "metricThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleSize",
        "executionMinimumSampleSize",
        "qualityMinimumSampleSize",
        "baselineLift",
        "minimumBaselineLift",
        "executionSampleThresholdMet",
        "qualitySampleThresholdMet",
        "baselineLiftPositive"
      ],
      "properties": {
        "sampleSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "executionMinimumSampleSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "qualityMinimumSampleSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "baselineLift": { "$ref": "#/$defs/nullableNumber" },
        "minimumBaselineLift": { "type": "number" },
        "executionSampleThresholdMet": { "type": "boolean" },
        "qualitySampleThresholdMet": { "type": "boolean" },
        "baselineLiftPositive": { "type": "boolean" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionAllowed",
        "strongerMethodAllowed",
        "qualityClaimAllowed",
        "benchmarkClaimAllowed",
        "stateOfTheArtClaimAllowed"
      ],
      "properties": {
        "executionAllowed": { "type": "boolean" },
        "strongerMethodAllowed": { "type": "boolean" },
        "qualityClaimAllowed": { "type": "boolean" },
        "benchmarkClaimAllowed": { "type": "boolean" },
        "stateOfTheArtClaimAllowed": { "type": "boolean" }
      }
    },
    "reasonCodes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      }
    }
  }
}
