{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/resolution-runtime-reliability.schema.json",
  "title": "Resolution Runtime Reliability",
  "description": "Checked read model for resolution runtime failure handling, retry guidance, provenance, and live-source boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resolutionRuntimeReliabilityId",
    "generatedAt",
    "domain",
    "reliabilityMode",
    "runtimeScope",
    "failureTaxonomy",
    "provenanceLedger",
    "executionBoundary",
    "sourcePolicyBoundary",
    "warnings"
  ],
  "properties": {
    "resolutionRuntimeReliabilityId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "domain": { "$ref": "common.schema.json#/$defs/domain" },
    "reliabilityMode": {
      "type": "string",
      "enum": ["checked_fixture_read_model"]
    },
    "runtimeScope": {
      "type": "string",
      "enum": ["resolution_runtime_reliability"]
    },
    "failureTaxonomy": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "failureClass",
          "failureCategory",
          "runtimeStages",
          "retryable",
          "retryAfter",
          "nextAction",
          "sanitizedDiagnostic",
          "safeSignals",
          "rawDiagnosticsExposed",
          "stackTraceExposed",
          "absolutePathsExposed",
          "claimBoundary"
        ],
        "properties": {
          "failureClass": {
            "type": "string",
            "enum": [
              "source_availability",
              "empty_sources",
              "decode_failures",
              "schedule_join_failures",
              "coverage_gaps",
              "late_capture_window",
              "resolver_failures",
              "stale_state",
              "invalid_state",
              "network_timeouts",
              "rate_limits"
            ]
          },
          "failureCategory": {
            "type": "string",
            "enum": ["source", "decode", "join", "coverage", "resolver", "state", "network", "policy"]
          },
          "runtimeStages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "enum": [
                "forecast_live_capture",
                "forward_forecast_run",
                "resolution_job_scan",
                "scheduler_tick",
                "resolver_attempt",
                "resolution_outcome_capture",
                "shutdown_readback"
              ]
            }
          },
          "retryable": { "type": "boolean" },
          "retryAfter": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^PT[0-9]+[SMH]$"
              },
              {
                "type": "null"
              }
            ]
          },
          "nextAction": {
            "type": "string",
            "enum": [
              "retry_after_backoff",
              "wait_for_next_tick",
              "provide_fresh_source",
              "provide_window_capture",
              "rerun_schedule_join",
              "inspect_invalid_state",
              "read_resolved_outputs",
              "stop_and_request_confirmation"
            ]
          },
          "sanitizedDiagnostic": {
            "type": "string",
            "minLength": 12,
            "maxLength": 220
          },
          "safeSignals": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            }
          },
          "rawDiagnosticsExposed": { "type": "boolean" },
          "stackTraceExposed": { "type": "boolean" },
          "absolutePathsExposed": { "type": "boolean" },
          "claimBoundary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "createsForecastArtifacts",
              "createsResolutionArtifacts",
              "createsScoringRecords",
              "calibrationClaimAllowed"
            ],
            "properties": {
              "createsForecastArtifacts": { "type": "boolean" },
              "createsResolutionArtifacts": { "type": "boolean" },
              "createsScoringRecords": { "type": "boolean" },
              "calibrationClaimAllowed": { "type": "boolean" }
            }
          }
        }
      }
    },
    "provenanceLedger": {
      "type": "array",
      "minItems": 5,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runtimeActionId",
          "actionType",
          "command",
          "timestamp",
          "sourceProvider",
          "sourceRole",
          "evidenceClassification",
          "forecastTimeEvidence",
          "resolutionOnlyEvidence",
          "allowedArtifactPaths",
          "artifactHashStatus",
          "diagnostics"
        ],
        "properties": {
          "runtimeActionId": { "$ref": "common.schema.json#/$defs/id" },
          "actionType": {
            "type": "string",
            "enum": [
              "forecast_live_capture",
              "forward_forecast_run",
              "resolution_job_scan",
              "scheduler_tick",
              "resolver_attempt",
              "shutdown_readback"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "timestamp": { "$ref": "common.schema.json#/$defs/timestamp" },
          "sourceProvider": {
            "type": "string",
            "enum": [
              "fixture_replay",
              "ignored_local_live_workspace",
              "hsl_gtfs_rt",
              "open_meteo",
              "local_scheduler"
            ]
          },
          "sourceRole": {
            "type": "string",
            "enum": [
              "forecast_time_transit_feed",
              "forecast_time_weather",
              "forward_run_state",
              "resolution_outcome",
              "scheduler_control",
              "runtime_log"
            ]
          },
          "evidenceClassification": {
            "type": "string",
            "enum": ["forecast_time", "resolution_only", "runtime_control"]
          },
          "forecastTimeEvidence": { "type": "boolean" },
          "resolutionOnlyEvidence": { "type": "boolean" },
          "allowedArtifactPaths": {
            "type": "array",
            "minItems": 0,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "artifactHashStatus": {
            "type": "string",
            "enum": ["paths_only", "not_applicable"]
          },
          "diagnostics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "diagnosticLevel",
              "status",
              "rawDiagnosticsExposed",
              "stackTraceExposed"
            ],
            "properties": {
              "diagnosticLevel": {
                "type": "string",
                "enum": ["sanitized_summary"]
              },
              "status": {
                "type": "string",
                "enum": ["ok", "not_run", "sanitized_failure"]
              },
              "rawDiagnosticsExposed": { "type": "boolean" },
              "stackTraceExposed": { "type": "boolean" }
            }
          }
        }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readModelDoesNotExecute",
        "normalChecksUseLiveNetwork",
        "usesPostCloseOutcomeAsForecastEvidence",
        "createsForecastArtifacts",
        "createsResolutionArtifacts",
        "createsScoringRecords",
        "fetchesLiveData",
        "storesCredentials",
        "createsHostedRuntime",
        "createsOsScheduler",
        "createsCalibrationClaims"
      ],
      "properties": {
        "readModelDoesNotExecute": { "type": "boolean" },
        "normalChecksUseLiveNetwork": { "type": "boolean" },
        "usesPostCloseOutcomeAsForecastEvidence": { "type": "boolean" },
        "createsForecastArtifacts": { "type": "boolean" },
        "createsResolutionArtifacts": { "type": "boolean" },
        "createsScoringRecords": { "type": "boolean" },
        "fetchesLiveData": { "type": "boolean" },
        "storesCredentials": { "type": "boolean" },
        "createsHostedRuntime": { "type": "boolean" },
        "createsOsScheduler": { "type": "boolean" },
        "createsCalibrationClaims": { "type": "boolean" }
      }
    },
    "sourcePolicyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liveCapturesAreLocalOnly",
        "liveCaptureRequiresExplicitFlag",
        "liveCaptureWorkspace",
        "liveCaptureFilesCommitted",
        "outcomeDataIsResolutionOnly",
        "resolutionOutcomeMayEnterForecastProvenance",
        "sourcePolicyRequiredBeforeHostedRuntime"
      ],
      "properties": {
        "liveCapturesAreLocalOnly": { "type": "boolean" },
        "liveCaptureRequiresExplicitFlag": { "type": "boolean" },
        "liveCaptureWorkspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "liveCaptureFilesCommitted": { "type": "boolean" },
        "outcomeDataIsResolutionOnly": { "type": "boolean" },
        "resolutionOutcomeMayEnterForecastProvenance": { "type": "boolean" },
        "sourcePolicyRequiredBeforeHostedRuntime": { "type": "boolean" }
      }
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 240
      }
    }
  }
}
