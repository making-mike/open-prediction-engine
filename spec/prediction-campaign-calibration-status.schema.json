{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/prediction-campaign-calibration-status.schema.json",
  "title": "Prediction Campaign Calibration Status",
  "description": "Checked campaign calibration-status and post-calibration continuation readback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "predictionCampaignCalibrationStatusId",
    "generatedAt",
    "calibrationStatus",
    "calibrationCase",
    "domain",
    "bindings",
    "thresholdReadback",
    "calibrationReadback",
    "pilotSummary",
    "postCalibrationPolicy",
    "cycleState",
    "commandSurface",
    "summary",
    "executionBoundary",
    "warnings"
  ],
  "properties": {
    "predictionCampaignCalibrationStatusId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "calibrationStatus": {
      "type": "string",
      "enum": [
        "not_enough_resolved_comparable_outcomes",
        "ready",
        "blocked_too_many_exclusions",
        "blocked_incomplete_provenance",
        "post_calibration_restart_ready"
      ]
    },
    "calibrationCase": {
      "type": "string",
      "enum": ["below_threshold", "threshold_met", "too_many_exclusions", "post_calibration_restart", "local_ledger"]
    },
    "domain": { "$ref": "common.schema.json#/$defs/domain" },
    "bindings": { "$ref": "#/$defs/bindings" },
    "thresholdReadback": { "$ref": "#/$defs/thresholdReadback" },
    "calibrationReadback": { "$ref": "#/$defs/calibrationReadback" },
    "pilotSummary": { "$ref": "#/$defs/pilotSummary" },
    "postCalibrationPolicy": { "$ref": "#/$defs/postCalibrationPolicy" },
    "cycleState": { "$ref": "#/$defs/cycleState" },
    "commandSurface": { "$ref": "#/$defs/commandSurface" },
    "summary": { "$ref": "#/$defs/summary" },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "warnings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/boundedString" }
    }
  },
  "$defs": {
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 720
    },
    "boundedStringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/boundedString" }
    },
    "calibrationStatus": {
      "type": "string",
      "enum": [
        "ready",
        "not_enough_resolved_comparable_outcomes",
        "blocked_too_many_exclusions",
        "blocked_incomplete_provenance",
        "post_calibration_restart_ready"
      ]
    },
    "noneOrTimestamp": {
      "type": "string",
      "minLength": 4,
      "maxLength": 40
    },
    "nullableCalibrationSummary": {
      "oneOf": [
        { "$ref": "#/$defs/calibrationSummary" },
        { "type": "null" }
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predictionCampaignManifestId",
        "repeatingPredictionSetupId",
        "transitBaselineTrackRecordGateId",
        "campaignId",
        "cycleId",
        "sourcePolicyId",
        "recurrenceCaseKey"
      ],
      "properties": {
        "predictionCampaignManifestId": { "$ref": "common.schema.json#/$defs/id" },
        "repeatingPredictionSetupId": { "$ref": "common.schema.json#/$defs/id" },
        "transitBaselineTrackRecordGateId": { "$ref": "common.schema.json#/$defs/id" },
        "campaignId": { "$ref": "common.schema.json#/$defs/id" },
        "cycleId": { "$ref": "common.schema.json#/$defs/id" },
        "sourcePolicyId": { "$ref": "common.schema.json#/$defs/id" },
        "recurrenceCaseKey": { "$ref": "#/$defs/boundedString" }
      }
    },
    "thresholdReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolvedComparableSampleSize",
        "scoredSampleSize",
        "excludedSampleSize",
        "minimumComparableResolvedForTrackRecord",
        "minimumComparableResolvedForCalibration",
        "maxExclusionRateForCalibrationClaim",
        "exclusionRate",
        "sourceOutcomeProvenanceComplete",
        "campaignLedgerPath",
        "trackRecordStatus",
        "calibrationStatus",
        "campaignLedgerIncluded",
        "campaignLedgerCase"
      ],
      "properties": {
        "resolvedComparableSampleSize": { "type": "integer", "minimum": 0 },
        "scoredSampleSize": { "type": "integer", "minimum": 0 },
        "excludedSampleSize": { "type": "integer", "minimum": 0 },
        "minimumComparableResolvedForTrackRecord": { "type": "integer", "minimum": 1 },
        "minimumComparableResolvedForCalibration": { "type": "integer", "minimum": 1 },
        "maxExclusionRateForCalibrationClaim": { "type": "number", "minimum": 0, "maximum": 1 },
        "exclusionRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "sourceOutcomeProvenanceComplete": { "type": "boolean" },
        "campaignLedgerPath": { "$ref": "#/$defs/boundedString" },
        "trackRecordStatus": {
          "type": "string",
          "enum": ["ready", "not_enough_resolved_comparable_outcomes"]
        },
        "calibrationStatus": { "$ref": "#/$defs/calibrationStatus" },
        "campaignLedgerIncluded": { "type": "boolean" },
        "campaignLedgerCase": { "$ref": "#/$defs/boundedString" }
      }
    },
    "calibrationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibrationSummaryId",
        "sampleSize",
        "expectedCalibrationError",
        "bucketCount",
        "primaryScore",
        "baselineScore",
        "baselineLift",
        "eventRate",
        "buckets",
        "confidenceCaveats",
        "measurementOnly",
        "automaticProbabilityUpdateAllowed"
      ],
      "properties": {
        "calibrationSummaryId": { "$ref": "common.schema.json#/$defs/id" },
        "sampleSize": { "type": "integer", "minimum": 1 },
        "expectedCalibrationError": { "type": "number", "minimum": 0, "maximum": 1 },
        "bucketCount": { "type": "integer", "minimum": 1 },
        "primaryScore": { "type": "number", "minimum": 0 },
        "baselineScore": { "type": "number", "minimum": 0 },
        "baselineLift": { "type": "number" },
        "eventRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "buckets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/calibrationBucket" }
        },
        "confidenceCaveats": { "$ref": "#/$defs/boundedStringList" },
        "measurementOnly": { "type": "boolean" },
        "automaticProbabilityUpdateAllowed": { "type": "boolean" }
      }
    },
    "calibrationBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lowerProbability",
        "upperProbability",
        "count",
        "meanForecastProbability",
        "observedFrequency"
      ],
      "properties": {
        "lowerProbability": { "type": "number", "minimum": 0, "maximum": 1 },
        "upperProbability": { "type": "number", "minimum": 0, "maximum": 1 },
        "count": { "type": "integer", "minimum": 0 },
        "meanForecastProbability": { "type": "number", "minimum": 0, "maximum": 1 },
        "observedFrequency": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "calibrationReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summaryGenerated",
        "reasonCode",
        "calibrationSummary",
        "measurementOnly",
        "automaticModelTuningAllowed",
        "automaticMethodChangeAllowed"
      ],
      "properties": {
        "summaryGenerated": { "type": "boolean" },
        "reasonCode": { "$ref": "#/$defs/boundedString" },
        "calibrationSummary": { "$ref": "#/$defs/nullableCalibrationSummary" },
        "measurementOnly": { "type": "boolean" },
        "automaticModelTuningAllowed": { "type": "boolean" },
        "automaticMethodChangeAllowed": { "type": "boolean" }
      }
    },
    "pilotSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementationEvidence",
        "trackRecordEvidence",
        "calibrationEvidence",
        "qualityClaim"
      ],
      "properties": {
        "implementationEvidence": { "$ref": "#/$defs/boundedString" },
        "trackRecordEvidence": { "$ref": "#/$defs/boundedString" },
        "calibrationEvidence": { "$ref": "#/$defs/boundedString" },
        "qualityClaim": { "$ref": "#/$defs/boundedString" }
      }
    },
    "postCalibrationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "delay", "nextCycleRule", "automaticMethodChangeAllowed"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["stop", "continue", "pause_then_resume_after", "start_next_cycle_after"]
        },
        "delay": { "$ref": "#/$defs/boundedString" },
        "nextCycleRule": { "$ref": "#/$defs/boundedString" },
        "automaticMethodChangeAllowed": { "type": "boolean" }
      }
    },
    "cycleState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycleState",
        "thresholdReached",
        "thresholdReachedAt",
        "postCalibrationAction",
        "pauseUntil",
        "nextCycleId",
        "writesCampaignState"
      ],
      "properties": {
        "cycleState": {
          "type": "string",
          "enum": [
            "collecting_evidence",
            "threshold_met_pending_policy",
            "needs_review",
            "pause_scheduled"
          ]
        },
        "thresholdReached": { "type": "boolean" },
        "thresholdReachedAt": { "$ref": "#/$defs/noneOrTimestamp" },
        "postCalibrationAction": { "$ref": "#/$defs/boundedString" },
        "pauseUntil": { "$ref": "#/$defs/noneOrTimestamp" },
        "nextCycleId": { "$ref": "#/$defs/boundedString" },
        "writesCampaignState": { "type": "boolean" }
      }
    },
    "commandSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "acceptedFlags", "defaultMode", "capturedStdoutMode", "normalChecksMutateState"],
      "properties": {
        "command": { "$ref": "#/$defs/boundedString" },
        "acceptedFlags": { "$ref": "#/$defs/boundedStringList" },
        "defaultMode": { "$ref": "#/$defs/boundedString" },
        "capturedStdoutMode": { "$ref": "#/$defs/boundedString" },
        "normalChecksMutateState": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibrationStatusReadbackImplemented",
        "calibrationSummaryGenerated",
        "postCalibrationContinuationDecisionImplemented",
        "methodUpdateImplemented",
        "writesCampaignState",
        "qualityClaimAllowed",
        "calibrationClaimAllowed",
        "recommendedNextAction"
      ],
      "properties": {
        "calibrationStatusReadbackImplemented": { "type": "boolean" },
        "calibrationSummaryGenerated": { "type": "boolean" },
        "postCalibrationContinuationDecisionImplemented": { "type": "boolean" },
        "methodUpdateImplemented": { "type": "boolean" },
        "writesCampaignState": { "type": "boolean" },
        "qualityClaimAllowed": { "type": "boolean" },
        "calibrationClaimAllowed": { "type": "boolean" },
        "recommendedNextAction": { "$ref": "#/$defs/boundedString" }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readsIgnoredLiveState",
        "writesIgnoredLiveState",
        "writesCampaignState",
        "fetchesLiveData",
        "executesResolvers",
        "createsCalibrationSummaryBelowThreshold",
        "updatesForecastProbabilities",
        "changesForecastMethod",
        "startsNextCycle"
      ],
      "properties": {
        "readsIgnoredLiveState": { "type": "boolean" },
        "writesIgnoredLiveState": { "type": "boolean" },
        "writesCampaignState": { "type": "boolean" },
        "fetchesLiveData": { "type": "boolean" },
        "executesResolvers": { "type": "boolean" },
        "createsCalibrationSummaryBelowThreshold": { "type": "boolean" },
        "updatesForecastProbabilities": { "type": "boolean" },
        "changesForecastMethod": { "type": "boolean" },
        "startsNextCycle": { "type": "boolean" }
      }
    }
  }
}
