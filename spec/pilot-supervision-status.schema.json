{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/pilot-supervision-status.schema.json",
  "title": "Pilot Supervision Status",
  "description": "Read-only operator status for running supervised pilot sessions and appending sanitized local pilot evidence without fabricating real sessions or unblocking quality claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pilotSupervisionStatusId",
    "generatedAt",
    "status",
    "localEvidenceMode",
    "localEvidenceStatus",
    "localLedgerPath",
    "sourceRecords",
    "realSessionProgress",
    "recommendedNextTask",
    "commandSequence",
    "evidenceLoopChecks",
    "executionBoundary",
    "warnings",
    "summary"
  ],
  "properties": {
    "pilotSupervisionStatusId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "status": {
      "type": "string",
      "enum": ["real_sessions_needed", "minimum_met_review_ready", "target_met_review_ready"]
    },
    "localEvidenceMode": {
      "type": "string",
      "enum": ["not_requested", "ignored_local_ledger"]
    },
    "localEvidenceStatus": {
      "type": "string",
      "enum": ["not_requested", "missing", "readable"]
    },
    "localLedgerPath": { "type": "string", "minLength": 1, "maxLength": 620 },
    "sourceRecords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pilotEvidenceLedgerId", "pilotSummaryIntakeId", "pilotSessionPacketId", "simulatedAgentPilotId"],
      "properties": {
        "pilotEvidenceLedgerId": { "$ref": "common.schema.json#/$defs/id" },
        "pilotSummaryIntakeId": { "$ref": "common.schema.json#/$defs/id" },
        "pilotSessionPacketId": { "$ref": "common.schema.json#/$defs/id" },
        "simulatedAgentPilotId": { "$ref": "common.schema.json#/$defs/id" }
      }
    },
    "realSessionProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptedRealSessionCount",
        "minimumRealSessions",
        "targetRealSessions",
        "remainingMinimumSessions",
        "remainingTargetSessions",
        "minimumMet",
        "targetMet"
      ],
      "properties": {
        "acceptedRealSessionCount": { "type": "integer", "minimum": 0 },
        "minimumRealSessions": { "type": "integer", "minimum": 1 },
        "targetRealSessions": { "type": "integer", "minimum": 1 },
        "remainingMinimumSessions": { "type": "integer", "minimum": 0 },
        "remainingTargetSessions": { "type": "integer", "minimum": 0 },
        "minimumMet": { "type": "boolean" },
        "targetMet": { "type": "boolean" }
      }
    },
    "recommendedNextTask": { "$ref": "#/$defs/recommendedTask" },
    "commandSequence": {
      "type": "array",
      "minItems": 5,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/commandStep" }
    },
    "evidenceLoopChecks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/evidenceCheck" }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readOnlyStatus",
        "usesCheckedPilotPacket",
        "writesCheckedFixtures",
        "writesIgnoredLocalLedger",
        "recordsRawTranscripts",
        "storesPrivateData",
        "storesCredentials",
        "storesPromptLogs",
        "storesParticipantIdentity",
        "unblocksExpansion",
        "qualityClaimsUpgraded",
        "calibrationClaimsUpgraded",
        "hostedRuntimeUnblocked",
        "generatedTypesUnblocked"
      ],
      "properties": {
        "readOnlyStatus": { "type": "boolean" },
        "usesCheckedPilotPacket": { "type": "boolean" },
        "writesCheckedFixtures": { "type": "boolean" },
        "writesIgnoredLocalLedger": { "type": "boolean" },
        "recordsRawTranscripts": { "type": "boolean" },
        "storesPrivateData": { "type": "boolean" },
        "storesCredentials": { "type": "boolean" },
        "storesPromptLogs": { "type": "boolean" },
        "storesParticipantIdentity": { "type": "boolean" },
        "unblocksExpansion": { "type": "boolean" },
        "qualityClaimsUpgraded": { "type": "boolean" },
        "calibrationClaimsUpgraded": { "type": "boolean" },
        "hostedRuntimeUnblocked": { "type": "boolean" },
        "generatedTypesUnblocked": { "type": "boolean" }
      }
    },
    "warnings": { "$ref": "#/$defs/boundedStringList" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "localEvidenceMode",
        "localEvidenceStatus",
        "localLedgerPath",
        "acceptedRealSessionCount",
        "minimumRealSessions",
        "targetRealSessions",
        "remainingMinimumSessions",
        "remainingTargetSessions",
        "minimumMet",
        "targetMet",
        "recommendedScenarioKey",
        "recommendedCommand",
        "pilotEvidenceReady",
        "expansionEvidenceReady",
        "qualityClaimAllowed",
        "calibrationClaimAllowed",
        "hostedRuntimeAllowed",
        "generatedTypesEvidenceReady"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["real_sessions_needed", "minimum_met_review_ready", "target_met_review_ready"]
        },
        "localEvidenceMode": {
          "type": "string",
          "enum": ["not_requested", "ignored_local_ledger"]
        },
        "localEvidenceStatus": {
          "type": "string",
          "enum": ["not_requested", "missing", "readable"]
        },
        "localLedgerPath": { "type": "string", "minLength": 1, "maxLength": 620 },
        "acceptedRealSessionCount": { "type": "integer", "minimum": 0 },
        "minimumRealSessions": { "type": "integer", "minimum": 1 },
        "targetRealSessions": { "type": "integer", "minimum": 1 },
        "remainingMinimumSessions": { "type": "integer", "minimum": 0 },
        "remainingTargetSessions": { "type": "integer", "minimum": 0 },
        "minimumMet": { "type": "boolean" },
        "targetMet": { "type": "boolean" },
        "recommendedScenarioKey": { "type": "string", "minLength": 1, "maxLength": 120 },
        "recommendedCommand": { "type": "string", "minLength": 1, "maxLength": 260 },
        "pilotEvidenceReady": { "type": "boolean" },
        "expansionEvidenceReady": { "type": "boolean" },
        "qualityClaimAllowed": { "type": "boolean" },
        "calibrationClaimAllowed": { "type": "boolean" },
        "hostedRuntimeAllowed": { "type": "boolean" },
        "generatedTypesEvidenceReady": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "boundedString": { "type": "string", "minLength": 1, "maxLength": 520 },
    "boundedStringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/boundedString" }
    },
    "recommendedTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "scenarioKey",
        "title",
        "command",
        "taskCommand",
        "expectedOutcomeClass",
        "measures",
        "claimBoundaryRequired",
        "reason"
      ],
      "properties": {
        "taskId": { "$ref": "common.schema.json#/$defs/id" },
        "scenarioKey": { "type": "string", "minLength": 1, "maxLength": 120 },
        "title": { "type": "string", "minLength": 1, "maxLength": 220 },
        "command": { "type": "string", "minLength": 1, "maxLength": 260 },
        "taskCommand": { "type": "string", "minLength": 1, "maxLength": 260 },
        "expectedOutcomeClass": { "type": "string", "minLength": 1, "maxLength": 160 },
        "measures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "claimBoundaryRequired": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/boundedString" }
      }
    },
    "commandStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepKey", "order", "command", "expectedOperatorAction", "mutatesLocalState"],
      "properties": {
        "stepKey": { "type": "string", "minLength": 1, "maxLength": 120 },
        "order": { "type": "integer", "minimum": 1, "maximum": 12 },
        "command": { "type": "string", "minLength": 1, "maxLength": 260 },
        "expectedOperatorAction": { "$ref": "#/$defs/boundedString" },
        "mutatesLocalState": { "type": "boolean" }
      }
    },
    "evidenceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkKey", "required", "command", "acceptance"],
      "properties": {
        "checkKey": { "type": "string", "minLength": 1, "maxLength": 120 },
        "required": { "type": "boolean" },
        "command": { "type": "string", "minLength": 1, "maxLength": 260 },
        "acceptance": { "$ref": "#/$defs/boundedString" }
      }
    }
  }
}
