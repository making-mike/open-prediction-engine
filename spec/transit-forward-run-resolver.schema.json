{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/transit-forward-run-resolver.schema.json",
  "title": "Transit Forward Run Resolver",
  "description": "Checked local resolver-agent scan over weather-transit-delay forward-run states.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transitForwardRunResolverId",
    "generatedAt",
    "runMode",
    "executionMode",
    "workspace",
    "now",
    "scanSummary",
    "runDecisions",
    "executionBoundary",
    "warnings"
  ],
  "properties": {
    "transitForwardRunResolverId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "runMode": {
      "type": "string",
      "enum": ["fixture_scan", "live_scan", "live_execute"]
    },
    "executionMode": {
      "type": "string",
      "enum": ["dry_run", "execute"]
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "now": { "$ref": "common.schema.json#/$defs/timestamp" },
    "scanSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scannedCount",
        "dueCount",
        "notDueCount",
        "alreadyResolvedCount",
        "invalidCount",
        "executedCount",
        "failedCount"
      ],
      "properties": {
        "scannedCount": { "type": "integer", "minimum": 0 },
        "dueCount": { "type": "integer", "minimum": 0 },
        "notDueCount": { "type": "integer", "minimum": 0 },
        "alreadyResolvedCount": { "type": "integer", "minimum": 0 },
        "invalidCount": { "type": "integer", "minimum": 0 },
        "executedCount": { "type": "integer", "minimum": 0 },
        "failedCount": { "type": "integer", "minimum": 0 }
      }
    },
    "runDecisions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statePath",
          "decision",
          "runStatus",
          "resolveAt",
          "due",
          "forecastId",
          "questionId",
          "serviceDate",
          "serviceWindow",
          "command",
          "notes"
        ],
        "properties": {
          "statePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "decision": {
            "type": "string",
            "enum": ["due_pending", "due_stale_capture", "not_due", "already_resolved", "executed", "failed", "invalid_state"]
          },
          "runStatus": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "resolveAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "due": { "type": "boolean" },
          "forecastId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "questionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "serviceDate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "serviceWindow": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "executionResult": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "exitCode"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["not_run", "succeeded", "failed"]
              },
              "exitCode": { "type": "integer", "minimum": 0 },
              "resolvedStatePath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "resolvedRunStatus": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "errorMessage": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          },
          "notes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 240
            }
          }
        }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalChecksUseLiveNetwork",
        "liveScanRequiresExplicitFlag",
        "executeRequiresExplicitFlag",
        "resolverCommandsExecuted",
        "sourceFetchPerformed",
        "resolvedArtifactsCreated",
        "hostedSchedulerCreated",
        "calibrationClaimAllowed"
      ],
      "properties": {
        "normalChecksUseLiveNetwork": { "type": "boolean" },
        "liveScanRequiresExplicitFlag": { "type": "boolean" },
        "executeRequiresExplicitFlag": { "type": "boolean" },
        "resolverCommandsExecuted": { "type": "boolean" },
        "sourceFetchPerformed": { "type": "boolean" },
        "resolvedArtifactsCreated": { "type": "boolean" },
        "hostedSchedulerCreated": { "type": "boolean" },
        "calibrationClaimAllowed": { "type": "boolean" }
      }
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 240
      }
    }
  }
}
