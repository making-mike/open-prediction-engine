{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/setup-engine.schema.json",
  "title": "Setup Engine",
  "description": "Checked domain-agnostic setup-engine readback for agents adding prediction to a host project.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "setupEngineId",
    "generatedAt",
    "inputMode",
    "goal",
    "engineSetupStatus",
    "recommendedFirstCommand",
    "requestSummary",
    "candidateForecastContracts",
    "requiredSourceRoles",
    "baselineGuidance",
    "forecastCardPreview",
    "hostWrapper",
    "claimBoundary",
    "exampleGoals",
    "interfaceBindings",
    "followUpSurfaces",
    "warnings",
    "createsForecastArtifacts",
    "hostedRuntimeRequired"
  ],
  "properties": {
    "setupEngineId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "inputMode": { "type": "string", "enum": ["goal_text", "structured_request"] },
    "goal": { "type": "string", "minLength": 3, "maxLength": 220 },
    "engineSetupStatus": { "type": "string", "enum": ["checked_readback"] },
    "recommendedFirstCommand": { "type": "string", "minLength": 12, "maxLength": 260 },
    "requestSummary": { "$ref": "#/$defs/requestSummary" },
    "candidateForecastContracts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/candidateForecastContract" }
    },
    "requiredSourceRoles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/sourceRole" }
    },
    "baselineGuidance": { "$ref": "#/$defs/baselineGuidance" },
    "forecastCardPreview": { "$ref": "#/$defs/forecastCardPreview" },
    "hostWrapper": { "$ref": "#/$defs/hostWrapper" },
    "claimBoundary": { "$ref": "#/$defs/claimBoundary" },
    "exampleGoals": {
      "type": "array",
      "minItems": 5,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/exampleGoal" }
    },
    "interfaceBindings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/interfaceBinding" }
    },
    "followUpSurfaces": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/followUpSurface" }
    },
    "warnings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 12, "maxLength": 260 }
    },
    "createsForecastArtifacts": { "type": "boolean" },
    "hostedRuntimeRequired": { "type": "boolean" }
  },
  "$defs": {
    "requestSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structuredRequestProvided",
        "completenessStatus",
        "providedSections",
        "approvedSourceHintCount",
        "needsApprovalSourceHintCount",
        "blockedInputFlags",
        "missingSourceRoles",
        "readyForSourceIntake",
        "safeToUseAsSetupInput",
        "requestCommand",
        "nextAction"
      ],
      "properties": {
        "structuredRequestProvided": { "type": "boolean" },
        "setupEngineRequestId": { "$ref": "common.schema.json#/$defs/id" },
        "completenessStatus": {
          "type": "string",
          "enum": [
            "goal_text_only",
            "ready_for_source_intake",
            "needs_source_approval",
            "blocked_by_unsafe_inputs",
            "needs_clarification"
          ]
        },
        "providedSections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "approvedSourceHintCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "needsApprovalSourceHintCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "blockedInputFlags": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "missingSourceRoles": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "readyForSourceIntake": { "type": "boolean" },
        "safeToUseAsSetupInput": { "type": "boolean" },
        "requestCommand": { "type": "string", "minLength": 8, "maxLength": 260 },
        "nextAction": { "type": "string", "minLength": 12, "maxLength": 260 }
      }
    },
    "candidateForecastContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "contractStatus",
        "title",
        "questionTemplate",
        "decisionToSupport",
        "horizon",
        "resolutionRule",
        "requiredSourceRoles",
        "baselineMethod",
        "reasonCodes",
        "nextAction"
      ],
      "properties": {
        "contractId": { "$ref": "common.schema.json#/$defs/id" },
        "contractStatus": { "type": "string", "enum": ["forecastable", "needs_clarification", "blocked", "rejected"] },
        "title": { "type": "string", "minLength": 8, "maxLength": 140 },
        "questionTemplate": { "type": "string", "minLength": 20, "maxLength": 260 },
        "decisionToSupport": { "type": "string", "minLength": 12, "maxLength": 220 },
        "horizon": { "type": "string", "minLength": 6, "maxLength": 120 },
        "resolutionRule": { "type": "string", "minLength": 20, "maxLength": 260 },
        "requiredSourceRoles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "baselineMethod": { "$ref": "#/$defs/baselineMethod" },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "nextAction": { "type": "string", "minLength": 12, "maxLength": 260 }
      }
    },
    "baselineMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methodId", "methodClass", "executionAllowed", "qualityClaimAllowed", "notes"],
      "properties": {
        "methodId": { "type": "string", "minLength": 3, "maxLength": 80 },
        "methodClass": { "type": "string", "enum": ["historical_baseline", "deterministic_baseline", "blocked"] },
        "executionAllowed": { "type": "boolean" },
        "qualityClaimAllowed": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 12, "maxLength": 220 }
      }
    },
    "sourceRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleName",
        "purpose",
        "acceptedSourceKinds",
        "requiredForForecast",
        "requiredForResolution",
        "acceptsCredentialValues",
        "acceptsRawPrivateRows",
        "acceptsRawSql",
        "nextAction"
      ],
      "properties": {
        "roleName": { "type": "string", "minLength": 3, "maxLength": 80 },
        "purpose": { "type": "string", "minLength": 12, "maxLength": 220 },
        "acceptedSourceKinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "requiredForForecast": { "type": "boolean" },
        "requiredForResolution": { "type": "boolean" },
        "acceptsCredentialValues": { "type": "boolean" },
        "acceptsRawPrivateRows": { "type": "boolean" },
        "acceptsRawSql": { "type": "boolean" },
        "nextAction": { "type": "string", "minLength": 12, "maxLength": 220 }
      }
    },
    "baselineGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultMethodId",
        "defaultMethodClass",
        "strongerMethodsAllowedAfter",
        "benchmarkGateRequired",
        "calibrationGateRequired",
        "notes"
      ],
      "properties": {
        "defaultMethodId": { "type": "string", "minLength": 3, "maxLength": 80 },
        "defaultMethodClass": { "type": "string", "enum": ["historical_baseline"] },
        "strongerMethodsAllowedAfter": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 3, "maxLength": 100 }
        },
        "benchmarkGateRequired": { "type": "boolean" },
        "calibrationGateRequired": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 12, "maxLength": 260 }
      }
    },
    "forecastCardPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previewStatus",
        "generatedFrom",
        "forecastArtifactCreated",
        "probabilityAvailable",
        "questionPreview",
        "outcomeLabel",
        "positiveClassLabel",
        "horizonLabel",
        "resolutionRulePreview",
        "evidenceStatus",
        "baselineStatus",
        "displaySections",
        "allowedPreviewFields",
        "blockedPreviewFields",
        "readCommandAfterForecast",
        "nextAction"
      ],
      "properties": {
        "previewStatus": {
          "type": "string",
          "enum": ["setup_only_not_forecast_artifact"]
        },
        "generatedFrom": {
          "type": "string",
          "enum": ["goal_text", "structured_request"]
        },
        "forecastArtifactCreated": { "type": "boolean" },
        "probabilityAvailable": { "type": "boolean" },
        "questionPreview": { "type": "string", "minLength": 12, "maxLength": 260 },
        "outcomeLabel": { "type": "string", "minLength": 3, "maxLength": 120 },
        "positiveClassLabel": { "type": "string", "minLength": 3, "maxLength": 140 },
        "horizonLabel": { "type": "string", "minLength": 6, "maxLength": 160 },
        "resolutionRulePreview": { "type": "string", "minLength": 20, "maxLength": 260 },
        "evidenceStatus": {
          "type": "string",
          "enum": [
            "source_intake_required",
            "source_approval_required",
            "structured_sources_ready_for_intake",
            "blocked_until_safe_sources"
          ]
        },
        "baselineStatus": {
          "type": "string",
          "enum": [
            "baseline_required_before_model_claims",
            "baseline_hint_ready",
            "blocked_until_safe_sources"
          ]
        },
        "displaySections": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "allowedPreviewFields": {
          "type": "array",
          "minItems": 6,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "blockedPreviewFields": {
          "type": "array",
          "minItems": 6,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "readCommandAfterForecast": { "type": "string", "minLength": 20, "maxLength": 180 },
        "nextAction": { "type": "string", "minLength": 12, "maxLength": 260 }
      }
    },
    "hostWrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wrapperStatus",
        "renderBeforeForecastArtifacts",
        "renderSections",
        "recommendedDataShape",
        "blockedHostResponsibilities",
        "nextAction"
      ],
      "properties": {
        "wrapperStatus": { "type": "string", "enum": ["ready_for_host_render"] },
        "renderBeforeForecastArtifacts": { "type": "boolean" },
        "renderSections": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "recommendedDataShape": { "type": "string", "minLength": 12, "maxLength": 220 },
        "blockedHostResponsibilities": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 3, "maxLength": 120 }
        },
        "nextAction": { "type": "string", "minLength": 12, "maxLength": 220 }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualityClaimAllowed",
        "calibrationClaimAllowed",
        "hostedRuntimeProvided",
        "trainedModelProvided",
        "executesLiveFetch",
        "acceptsRawSql",
        "acceptsCredentialValues",
        "acceptsRawPrivateRows",
        "minimumResolvedOutcomesForQualityClaim",
        "notes"
      ],
      "properties": {
        "qualityClaimAllowed": { "type": "boolean" },
        "calibrationClaimAllowed": { "type": "boolean" },
        "hostedRuntimeProvided": { "type": "boolean" },
        "trainedModelProvided": { "type": "boolean" },
        "executesLiveFetch": { "type": "boolean" },
        "acceptsRawSql": { "type": "boolean" },
        "acceptsCredentialValues": { "type": "boolean" },
        "acceptsRawPrivateRows": { "type": "boolean" },
        "minimumResolvedOutcomesForQualityClaim": { "type": "integer", "minimum": 30, "maximum": 10000 },
        "notes": { "type": "string", "minLength": 12, "maxLength": 260 }
      }
    },
    "exampleGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goalKey", "goal", "classification", "reasonCodes", "preferredView"],
      "properties": {
        "goalKey": { "type": "string", "minLength": 3, "maxLength": 80 },
        "goal": { "type": "string", "minLength": 12, "maxLength": 220 },
        "classification": { "type": "string", "enum": ["forecastable", "needs_clarification", "blocked", "rejected"] },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "preferredView": { "type": "string", "enum": ["contracts", "sources", "baseline", "claim-boundary", "examples"] }
      }
    },
    "interfaceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "implementedStatus", "command", "boundary"],
      "properties": {
        "interface": { "type": "string", "enum": ["cli", "agent_call", "local_mcp"] },
        "implementedStatus": { "type": "string", "enum": ["implemented_local"] },
        "command": { "type": "string", "minLength": 8, "maxLength": 260 },
        "toolName": { "type": "string", "minLength": 3, "maxLength": 80 },
        "boundary": { "type": "string", "minLength": 12, "maxLength": 260 }
      }
    },
    "followUpSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "command", "relationship"],
      "properties": {
        "surface": { "type": "string", "minLength": 3, "maxLength": 80 },
        "command": { "type": "string", "minLength": 8, "maxLength": 260 },
        "relationship": { "type": "string", "minLength": 12, "maxLength": 260 }
      }
    }
  }
}
