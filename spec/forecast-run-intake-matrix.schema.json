{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/forecast-run-intake-matrix.schema.json",
  "title": "Forecast Run Intake Matrix",
  "description": "Agent-facing matrix of forecast-run request outcomes and safe next actions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "forecastRunIntakeMatrixId",
    "generatedAt",
    "domain",
    "supportedDefaultRequestId",
    "summarySchema",
    "outcomes",
    "warnings"
  ],
  "properties": {
    "forecastRunIntakeMatrixId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "domain": { "$ref": "common.schema.json#/$defs/domain" },
    "supportedDefaultRequestId": { "$ref": "common.schema.json#/$defs/id" },
    "summarySchema": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "outcomes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/outcome" }
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 240
      }
    }
  },
  "$defs": {
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcomeClass",
        "requestFixture",
        "summaryPath",
        "forecastRunSummaryId",
        "runStatus",
        "decisionStatus",
        "errorCode",
        "generatesForecastOutputs",
        "terminal",
        "retryPolicy",
        "agentNextAction",
        "mcpExpectation"
      ],
      "properties": {
        "outcomeClass": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "blocked",
            "canceled",
            "unsupported_fixture_path",
            "response_too_large"
          ]
        },
        "requestFixture": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "summaryPath": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "forecastRunSummaryId": { "$ref": "common.schema.json#/$defs/id" },
        "runStatus": {
          "type": "string",
          "enum": ["completed", "blocked", "rejected", "canceled", "failed"]
        },
        "decisionStatus": {
          "type": "string",
          "enum": ["accepted", "blocked", "rejected", "canceled"]
        },
        "errorCode": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 3,
              "maxLength": 80
            },
            { "type": "null" }
          ]
        },
        "generatesForecastOutputs": { "type": "boolean" },
        "terminal": { "type": "boolean" },
        "retryPolicy": {
          "type": "string",
          "enum": [
            "not_needed",
            "approval_then_retry",
            "revise_request_then_retry",
            "stop_terminal",
            "supported_fixture_or_runtime_expansion_required",
            "increase_max_bytes_or_read_smaller_output"
          ]
        },
        "agentNextAction": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "mcpExpectation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["toolName", "isError", "structuredSchema"],
          "properties": {
            "toolName": {
              "type": "string",
              "const": "ope_forecast_run"
            },
            "isError": { "type": "boolean" },
            "structuredSchema": {
              "type": "string",
              "const": "spec/forecast-run-summary.schema.json"
            }
          }
        }
      }
    }
  }
}
