{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprediction.engine/spec/runtime-security.schema.json",
  "title": "Runtime Security And Hardening",
  "description": "Checked lightweight runtime hardening readback for embedded local OPE execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtimeSecurityId",
    "generatedAt",
    "securityStatus",
    "runtimeScope",
    "dependencyBudget",
    "moduleBoundaries",
    "runtimeSurfaceControls",
    "pathAndDatabaseGuards",
    "credentialHandling",
    "threatModelNotes",
    "agentReadableChecks",
    "blockedExamples",
    "executionBoundary",
    "summary",
    "warnings"
  ],
  "properties": {
    "runtimeSecurityId": { "$ref": "common.schema.json#/$defs/id" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "securityStatus": { "type": "string", "enum": ["lightweight_runtime_hardening_checked"] },
    "runtimeScope": { "type": "string", "enum": ["embedded_local_runtime"] },
    "dependencyBudget": { "$ref": "#/$defs/dependencyBudget" },
    "moduleBoundaries": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/moduleBoundary" }
    },
    "runtimeSurfaceControls": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/runtimeSurfaceControl" }
    },
    "pathAndDatabaseGuards": { "$ref": "#/$defs/pathAndDatabaseGuards" },
    "credentialHandling": { "$ref": "#/$defs/credentialHandling" },
    "threatModelNotes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/threatModelNote" }
    },
    "agentReadableChecks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/agentReadableCheck" }
    },
    "blockedExamples": {
      "type": "array",
      "minItems": 5,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/blockedExample" }
    },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "summary": { "$ref": "#/$defs/summary" },
    "warnings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 12, "maxLength": 220 }
    }
  },
  "$defs": {
    "dependencyBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coreRuntimeDependencyPolicy",
        "allowedRuntimeDependencyGroups",
        "runtimeDependencies",
        "runtimeDependencyCount",
        "thirdPartyRuntimeDependenciesAllowed",
        "devOnlyDependencies",
        "packageInstallRequiredForNormalChecks",
        "checkedBy",
        "notes"
      ],
      "properties": {
        "coreRuntimeDependencyPolicy": { "type": "string", "enum": ["python_stdlib_only"] },
        "allowedRuntimeDependencyGroups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string", "enum": ["python_standard_library"] }
        },
        "runtimeDependencies": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        },
        "runtimeDependencyCount": { "type": "integer", "minimum": 0, "maximum": 0 },
        "thirdPartyRuntimeDependenciesAllowed": { "type": "boolean" },
        "devOnlyDependencies": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 2, "maxLength": 40 }
        },
        "packageInstallRequiredForNormalChecks": { "type": "boolean" },
        "checkedBy": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 8, "maxLength": 140 }
        },
        "notes": { "type": "string", "minLength": 12, "maxLength": 260 }
      }
    },
    "moduleBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleName",
        "modulePath",
        "responsibility",
        "allowedCallClasses",
        "forbiddenCallClasses",
        "singleResponsibility",
        "rawSqlExposed",
        "credentialValuesAccepted",
        "hiddenServiceRequired",
        "adapterBoundaryDocumented"
      ],
      "properties": {
        "moduleName": {
          "type": "string",
          "enum": [
            "core_lifecycle",
            "storage_adapter",
            "source_adapter",
            "method_adapter",
            "transport_adapter",
            "worker_runtime",
            "domain_source_setup"
          ]
        },
        "modulePath": { "type": "string", "minLength": 8, "maxLength": 160 },
        "responsibility": { "type": "string", "minLength": 20, "maxLength": 260 },
        "allowedCallClasses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "forbiddenCallClasses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "singleResponsibility": { "type": "boolean" },
        "rawSqlExposed": { "type": "boolean" },
        "credentialValuesAccepted": { "type": "boolean" },
        "hiddenServiceRequired": { "type": "boolean" },
        "adapterBoundaryDocumented": { "type": "boolean" }
      }
    },
    "runtimeSurfaceControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaceName",
        "ownerModule",
        "pathAllowlistRequired",
        "symlinkEscapeCheckRequired",
        "databasePathCheckRequired",
        "inputSizeLimitBytes",
        "responseSizeLimitBytes",
        "sanitizedDiagnosticsRequired",
        "credentialReferenceOnly",
        "credentialValuesStored",
        "networkAccessDefault",
        "rawSqlExposed",
        "rawFileLayoutExposed",
        "notes"
      ],
      "properties": {
        "surfaceName": {
          "type": "string",
          "enum": [
            "embedded_internal_api",
            "local_sqlite_storage_adapter",
            "background_worker_runtime",
            "local_source_runtime",
            "domain_source_setup"
          ]
        },
        "ownerModule": {
          "type": "string",
          "enum": [
            "core_lifecycle",
            "storage_adapter",
            "source_adapter",
            "worker_runtime",
            "domain_source_setup"
          ]
        },
        "pathAllowlistRequired": { "type": "boolean" },
        "symlinkEscapeCheckRequired": { "type": "boolean" },
        "databasePathCheckRequired": { "type": "boolean" },
        "inputSizeLimitBytes": { "type": "integer", "minimum": 1024, "maximum": 262144 },
        "responseSizeLimitBytes": { "type": "integer", "minimum": 1024, "maximum": 65536 },
        "sanitizedDiagnosticsRequired": { "type": "boolean" },
        "credentialReferenceOnly": { "type": "boolean" },
        "credentialValuesStored": { "type": "boolean" },
        "networkAccessDefault": { "type": "string", "enum": ["disabled"] },
        "rawSqlExposed": { "type": "boolean" },
        "rawFileLayoutExposed": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 12, "maxLength": 260 }
      }
    },
    "pathAndDatabaseGuards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedLocalStateRoots",
        "allowedFixtureRoots",
        "pathTraversalBlocked",
        "symlinkEscapeBlocked",
        "absolutePathRequiresApproval",
        "localSourcePathAllowlistRequired",
        "databasePathAllowlistRequired",
        "persistentDatabaseDefaultAllowed",
        "normalChecksUseEphemeralSqlite",
        "sanitizedDiagnostics"
      ],
      "properties": {
        "allowedLocalStateRoots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "allowedFixtureRoots": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 3, "maxLength": 120 }
        },
        "pathTraversalBlocked": { "type": "boolean" },
        "symlinkEscapeBlocked": { "type": "boolean" },
        "absolutePathRequiresApproval": { "type": "boolean" },
        "localSourcePathAllowlistRequired": { "type": "boolean" },
        "databasePathAllowlistRequired": { "type": "boolean" },
        "persistentDatabaseDefaultAllowed": { "type": "boolean" },
        "normalChecksUseEphemeralSqlite": { "type": "boolean" },
        "sanitizedDiagnostics": {
          "type": "array",
          "minItems": 4,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        }
      }
    },
    "credentialHandling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialValuesStoredInRecords",
        "credentialReferencesAllowed",
        "allowedCredentialFields",
        "redactionReceiptRequiredForUnsafeFields",
        "sourcePolicyIdRequired",
        "sanitizedProvenanceRequired",
        "environmentSecretEchoAllowed",
        "notes"
      ],
      "properties": {
        "credentialValuesStoredInRecords": { "type": "boolean" },
        "credentialReferencesAllowed": { "type": "boolean" },
        "allowedCredentialFields": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "redactionReceiptRequiredForUnsafeFields": { "type": "boolean" },
        "sourcePolicyIdRequired": { "type": "boolean" },
        "sanitizedProvenanceRequired": { "type": "boolean" },
        "environmentSecretEchoAllowed": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 12, "maxLength": 260 }
      }
    },
    "threatModelNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threatName",
        "risk",
        "mitigation",
        "mitigationStatus",
        "checkedBy",
        "rawSensitiveDataExposed"
      ],
      "properties": {
        "threatName": {
          "type": "string",
          "enum": [
            "malicious_source_data",
            "prompt_source_injection",
            "path_traversal",
            "idempotency_replay",
            "lease_abuse",
            "oversized_responses",
            "accidental_private_data_exposure"
          ]
        },
        "risk": { "type": "string", "minLength": 20, "maxLength": 260 },
        "mitigation": { "type": "string", "minLength": 20, "maxLength": 320 },
        "mitigationStatus": { "type": "string", "enum": ["checked_or_bounded"] },
        "checkedBy": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 8, "maxLength": 140 }
        },
        "rawSensitiveDataExposed": { "type": "boolean" }
      }
    },
    "agentReadableCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "purpose", "hiddenServiceRequired"],
      "properties": {
        "command": { "type": "string", "minLength": 8, "maxLength": 160 },
        "purpose": { "type": "string", "minLength": 16, "maxLength": 260 },
        "hiddenServiceRequired": { "type": "boolean" }
      }
    },
    "blockedExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseName", "blocked", "sanitizedDiagnosticCode", "rawValueEchoed", "safeNextAction"],
      "properties": {
        "caseName": {
          "type": "string",
          "enum": [
            "path_traversal",
            "symlink_escape",
            "database_outside_allowlist",
            "oversized_response",
            "credential_value_in_record"
          ]
        },
        "blocked": { "type": "boolean" },
        "sanitizedDiagnosticCode": { "type": "string", "minLength": 3, "maxLength": 80 },
        "rawValueEchoed": { "type": "boolean" },
        "safeNextAction": { "type": "string", "minLength": 12, "maxLength": 220 }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostedRuntimeRequired",
        "networkListenerStarted",
        "liveSourceFetchDefault",
        "credentialValuesStored",
        "rawSqlExposed",
        "rawFileLayoutExposed",
        "unboundedBackgroundLoopAllowed",
        "physicalDeleteAllowed"
      ],
      "properties": {
        "hostedRuntimeRequired": { "type": "boolean" },
        "networkListenerStarted": { "type": "boolean" },
        "liveSourceFetchDefault": { "type": "boolean" },
        "credentialValuesStored": { "type": "boolean" },
        "rawSqlExposed": { "type": "boolean" },
        "rawFileLayoutExposed": { "type": "boolean" },
        "unboundedBackgroundLoopAllowed": { "type": "boolean" },
        "physicalDeleteAllowed": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeDependencyCount",
        "moduleBoundaryCount",
        "surfaceControlCount",
        "threatModelNoteCount",
        "blockedExampleCount",
        "normalChecksStartHiddenService"
      ],
      "properties": {
        "runtimeDependencyCount": { "type": "integer", "minimum": 0, "maximum": 0 },
        "moduleBoundaryCount": { "type": "integer", "minimum": 7, "maximum": 7 },
        "surfaceControlCount": { "type": "integer", "minimum": 5, "maximum": 5 },
        "threatModelNoteCount": { "type": "integer", "minimum": 7, "maximum": 7 },
        "blockedExampleCount": { "type": "integer", "minimum": 5, "maximum": 5 },
        "normalChecksStartHiddenService": { "type": "boolean" }
      }
    }
  }
}
